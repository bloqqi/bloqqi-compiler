diagramtype A() {
    T_1;
    T_2;
    connect(T_1, T_2);
}
diagramtype B() extends A {
    T_3;
    intercept source T_1 with T_3, T_3;
}
diagramtype C() extends B {
    T_4;
    T_5;
    connect(T_1, T_4);
    connect(T_3, T_5);
}
diagramtype D() extends A {
    T_6;
    connect(T_1, T_6);
}
diagramtype E() extends D {
    T_7;
    connect(T_1, T_7);
}
diagramtype F() extends C, E {
    T_8;
    connect(T_1, T_8);
}

diagramtype T(Int in => Int out) {
}
