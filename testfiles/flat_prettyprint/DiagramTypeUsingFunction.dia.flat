function Sum(n: Int => out: Int) {
  i: Int;
  i = 1;
  while (i < n) {
    out = out + i;
    i = i + 1;
  }
}
diagramtype Print(in: Int) {
}
diagramtype T() {
  Add_1: Add;
  Add_2: Add;
  Sum_1: Sum;
  Print_1: Print;
  connect(1, Add_1.in1);
  connect(2, Add_1.in2);
  connect(Add_1.out, Add_2.in1);
  connect(3, Add_2.in2);
  connect(Add_2.out, Sum_1.n);
  connect(Sum_1.out, Print_1.in);
}

