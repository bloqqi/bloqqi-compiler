diagramtype Main(in: Int => out: Int) {
  block$add: Add;
  block2: Block;
}
diagramtype SubMain(in: Int => out: Int) {
  block$add: Add;
  block2: Block;
  connect(in, block2.in);
  connect(in, block$add.in1);
  connect(block$add.out, out);
}
diagramtype Block(in: Int => out: Int) {
  add: Add;
  connect(in, add.in1);
  connect(add.out, out);
}

