diagramtype ValveExtension(fill: Bool, interlock: Bool, fillingIn: Bool => fillingOut: Bool) {
  valve2: Valve;
  Or_1;
  connect(interlock, valve2.interlock);
  connect(fill, valve2.open);
  connect(valve2.status, Or_1.in2);
  connect(fillingIn, Or_1.in1);
  connect(Or_1.out, fillingOut);
}
annotation(
  Or_1 = (192, 48, 60, 30),
  fill = (12, 24, 60, 20),
  fillingIn = (102, 12, 60, 20),
  fillingOut = (282, 46, 60, 20),
  interlock = (12, 74, 60, 20),
  valve2 = (102, 62, 60, 30)
)
wiring ValveExtension[fill: Bool, interlock: Bool, =>filling: Bool] {
  connect(fill, ValveExtension.fill);
  connect(interlock, ValveExtension.interlock);
  intercept filling with ValveExtension.fillingIn, ValveExtension.fillingOut;
}
diagramtype PumpExtension(empty: Bool, interlock: Bool, emptyingIn: Bool => emptyingOut: Bool) {
  pump2: Pump;
  Or_2;
  connect(interlock, pump2.interlock);
  connect(empty, pump2.open);
  connect(pump2.status, Or_2.in2);
  connect(emptyingIn, Or_2.in1);
  connect(Or_2.out, emptyingOut);
}
wiring PumpExtension[empty: Bool, interlock: Bool, =>emptying: Bool] {
  connect(empty, PumpExtension.empty);
  connect(interlock, PumpExtension.interlock);
  intercept emptying with PumpExtension.emptyingIn, PumpExtension.emptyingOut;
}
