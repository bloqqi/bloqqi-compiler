diagramtype Main {
  tank: Tank {
    inline Agitating: AgitationExtension[agitate: Bool, level.out, empty, pump.interlock, =>agitating: Bool];
    inline Heating: HeatingExtension[heat: Bool, level.out, =>heating: Bool];
    inline Pump2: PumpExtension[empty2: Bool, Le_2.out, emptying];
    inline Valve2: ValveExtension[fill2: Bool, Le_1.out, filling] {
      redeclare valve2: AdvancedValve;
    };
    redeclare valve: AdvancedValve;
  };
  fill: OperatorBool;
  empty: OperatorBool;
  agitate: OperatorBool;
  heat: OperatorBool;
  empty2: OperatorBool;
  fill2: OperatorBool;
  filling: ActuatorBool;
  emptying: ActuatorBool;
  agitating: ActuatorBool;
  heating: ActuatorBool;
  tankEmpty: Tank;
  connect(fill.out, tank.fill);
  connect(empty.out, tank.empty);
  connect(agitate.out, tank.agitate);
  connect(heat.out, tank.heat);
  connect(empty2.out, tank.empty2);
  connect(fill2.out, tank.fill2);
  connect(tank.filling, filling.open);
  connect(tank.emptying, emptying.open);
  connect(tank.agitating, agitating.open);
  connect(tank.heating, heating.open);
}
