diagramtype TankAgitation(agitate: Bool => agitating: Bool) extends Tank {
  minLevelAgitation: SensorInt;
  Le_3;
  agitator: Motor;
  Or_1;
  Or_2;
  connect(Tank::level.out, Le_3.in1);
  connect(minLevelAgitation.out, Le_3.in2);
  connect(agitator.status, agitating);
  connect(agitate, agitator.open);
  intercept Tank::pump.interlock with Or_1.in1, Or_1.out;
  connect(Or_2.out, agitator.interlock);
  connect(Le_3.out, Or_2.in2);
  connect(agitate, Or_1.in2);
  connect(empty, Or_2.in1);
}
