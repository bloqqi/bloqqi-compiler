wiring HeatingExtension[heat: Bool, level: Int, =>heating: Bool] {
  connect(heat, HeatingExtension.heat);
  connect(level, HeatingExtension.level);
  connect(HeatingExtension.heating, heating);
}
diagramtype AgitationExtension(agitate: Bool, level: Int, empty: Bool, pumpInterlockIn: Bool => agitating: Bool, pumpInterlockOut: Bool) {
  minLevelAgitation: SensorInt;
  Le_3;
  agitator: Motor;
  Or_1;
  Or_2;
  connect(level, Le_3.in1);
  connect(minLevelAgitation.out, Le_3.in2);
  connect(agitator.status, agitating);
  connect(agitate, agitator.open);
  connect(Or_2.out, agitator.interlock);
  connect(Le_3.out, Or_2.in2);
  connect(pumpInterlockIn, Or_1.in1);
  connect(Or_1.out, pumpInterlockOut);
  connect(agitate, Or_1.in2);
  connect(empty, Or_2.in1);
}
