  Le_3 = (102, 138, 60, 30),
  Or_1 = (282, 50, 60, 30),
  Or_2 = (192, 124, 60, 30),
  agitate = (192, 62, 60, 20),
  agitating = (372, 108, 60, 20),
  agitator = (282, 110, 60, 30),
  empty = (102, 88, 60, 20),
  level = (12, 102, 60, 20),
  minLevelAgitation = (12, 152, 60, 20),
  pumpInterlockIn = (192, 12, 60, 20),
  pumpInterlockOut = (372, 48, 60, 20)
)
wiring AgitationExtension[agitate: Bool, level: Int, empty: Bool, =>pumpInterlock: Bool, =>agitating: Bool] {
  connect(agitate, AgitationExtension.agitate);
  connect(level, AgitationExtension.level);
  connect(empty, AgitationExtension.empty);
  intercept pumpInterlock with AgitationExtension.pumpInterlockIn, AgitationExtension.pumpInterlockOut;
  connect(AgitationExtension.agitating, agitating);
}
recommendation Tank {
  Valve2: ValveExtension[fill2: Bool, Le_1.out, filling];
  Pump2: PumpExtension[empty2: Bool, Le_2.out, emptying];
  Heating: HeatingExtension[heat: Bool, level.out, =>heating: Bool];
  Agitating: AgitationExtension[agitate: Bool, level.out, empty, pump.interlock, =>agitating: Bool];
  replaceable valve;
}
recommendation ValveExtension {
  replaceable valve2;
}

