  connect(temp.out, Le_4.in2);
  connect(Le_3.out, Or_1.in1);
  connect(Le_4.out, Or_1.in2);
  connect(Or_1.out, heater.interlock);
  connect(heat, heater.open);
  connect(heater.status, heating);
}
