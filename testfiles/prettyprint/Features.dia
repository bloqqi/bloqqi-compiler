diagramtype P {
}
diagramtype PI extends P {
}
diagramtype PD extends P {
}
diagramtype PTrack extends P {
}
diagramtype Main {
  pid: P {
    feature Derivative;
    feature Integral;
  };
}
features P {
  PTrack: PTrack;
  Integral xor PTrack;
}
features P {
  Derivative: PD;
  Integral: PI;
}
features P {
  Derivative before Integral;
  Derivative before PTrack;
}

