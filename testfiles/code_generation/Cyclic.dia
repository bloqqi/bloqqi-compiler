external Print(in: Int);

diagramtype Main {
	block: Block;
	print: Print;
	connect(1, block.in1);
	connect(block.out, block.in2);
	connect(block.out, print.in);
}
diagramtype Block(in1: Int, in2: Int => out: Int) {
	add: Add;
	connect(in1, add.in1);
	connect(in2, add.in2);
	connect(add.out, out);
}
