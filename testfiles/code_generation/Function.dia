external PrintStrInt(str: String, in: Int);
external PrintStrBool(str: String, in: Bool);

// Implemented in Function.external
external Triple(a: Int => out: Int);

// The expected value of each function is written above it, so that the
// expected output can be checked without running the compiler. Each value is
// printed together with the name of the function, since the order of the
// lines in the output follows the data flow.

// Operator precedence, without parentheses
// Arith(3, 4) = 3 + 4*2 - 1 = 10
function Arith(a: Int, b: Int => out: Int) {
  out = a + b * 2 - 1;
}

// DivMod(7, 2) = 7/2 + 7%2 = 3 + 1 = 4
function DivMod(a: Int, b: Int => out: Int) {
  out = a / b + a % b;
}

// Unary operators applied to an output parameter, which is a field of the
// result struct in the generated C code. Regression test: the operand was
// written as it is written in the program, so the generated C code became
//   _result.out = !out;
// which does not compile:
//   error: 'out' undeclared (first use in this function)
// Negate(true) = false
function Negate(a: Bool => out: Bool) {
  out = a;
  out = !out;
}

// Minus(5) = -5
function Minus(a: Int => out: Int) {
  out = a;
  out = -out;
}

// Comparison and logical operators
// Logic(1, 5) = (1 < 5 && 5 < 10) || 1 == 0 = true
function Logic(a: Int, b: Int => out: Bool) {
  out = a < b && b < 10 || a == 0;
}

// If statement
// Abs(-5) = 5
function Abs(a: Int => out: Int) {
  if (a < 0) {
    out = -a;
  } else {
    out = a;
  }
}

// While statement and local declaration
// Sum(5) = 0 + 1 + 2 + 3 + 4 = 10
function Sum(n: Int => out: Int) {
  out = 0;
  Int i = 0;
  while (i < n) {
    out = out + i;
    i = i + 1;
  }
}

// Calling another function
// SumAbs(-5, 4) = 5 + 4 = 9
function SumAbs(a: Int, b: Int => out: Int) {
  out = Abs(a) + Abs(b);
}

// Calling a function whose parameter type differs from its return type
// IsPositive(3) = true, IsPositive(-5) = false
function IsPositive(a: Int => out: Bool) {
  out = a > 0;
}

// CountPositive(3, -5) = 1, only the first argument is positive
function CountPositive(a: Int, b: Int => out: Int) {
  out = 0;
  if (IsPositive(a)) {
    out = out + 1;
  }
  if (IsPositive(b)) {
    out = out + 1;
  }
}

// Calling an external function, which returns its value directly
// CallExternal(4) = 3*4 + 1 = 13
function CallExternal(a: Int => out: Int) {
  out = Triple(a) + 1;
}

diagramtype Main {
  arith: Arith;
  divMod: DivMod;
  negate: Negate;
  minus: Minus;
  logic: Logic;
  abs: Abs;
  sum: Sum;
  sumAbs: SumAbs;
  count: CountPositive;
  callExt: CallExternal;

  pArith: PrintStrInt;
  pDivMod: PrintStrInt;
  pNegate: PrintStrBool;
  pMinus: PrintStrInt;
  pLogic: PrintStrBool;
  pAbs: PrintStrInt;
  pSum: PrintStrInt;
  pSumAbs: PrintStrInt;
  pCount: PrintStrInt;
  pCallExt: PrintStrInt;

  connect(3, arith.a);
  connect(4, arith.b);
  connect("arith:  ", pArith.str);
  connect(arith.out, pArith.in);

  connect(7, divMod.a);
  connect(2, divMod.b);
  connect("divMod: ", pDivMod.str);
  connect(divMod.out, pDivMod.in);

  connect(true, negate.a);
  connect("negate: ", pNegate.str);
  connect(negate.out, pNegate.in);

  connect(5, minus.a);
  connect("minus:  ", pMinus.str);
  connect(minus.out, pMinus.in);

  connect(1, logic.a);
  connect(5, logic.b);
  connect("logic:  ", pLogic.str);
  connect(logic.out, pLogic.in);

  connect(-5, abs.a);
  connect("abs:    ", pAbs.str);
  connect(abs.out, pAbs.in);

  connect(5, sum.n);
  connect("sum:    ", pSum.str);
  connect(sum.out, pSum.in);

  connect(-5, sumAbs.a);
  connect(4, sumAbs.b);
  connect("sumAbs: ", pSumAbs.str);
  connect(sumAbs.out, pSumAbs.in);

  connect(3, count.a);
  connect(-5, count.b);
  connect("count:  ", pCount.str);
  connect(count.out, pCount.in);

  connect(4, callExt.a);
  connect("callExt: ", pCallExt.str);
  connect(callExt.out, pCallExt.in);
}
