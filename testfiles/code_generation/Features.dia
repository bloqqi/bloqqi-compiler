external Print(in: Int);

diagramtype A(in: Int => out: Int) {
  connect(in, out);
}

diagramtype F extends A {
  Add_1;
  intercept out with Add_1.in1, Add_1.out;
  connect(1, Add_1.in2);
}

diagramtype G extends A {
  Mul_1;
  intercept out with Mul_1.in1, Mul_1.out;
  connect(2, Mul_1.in2);
}

diagramtype Main {
  print: Print;
  counter: Counter;
  a: A {
    feature f;
    feature g;
  };
  connect(counter, a);
  connect(a, print);
}

diagramtype Counter(=> out: Int) {
  var n: Int;
  Add_1;
  connect(n, Add_1.in1);
  connect(1, Add_1.in2);
  connect(Add_1.out, n);
  connect(Add_1.out, out);
}

features A {
  f: F;
}

features A {
  g: G;
  f before g;
}
