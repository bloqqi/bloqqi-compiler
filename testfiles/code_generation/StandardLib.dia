external Print(in: Int);
external PrintBool(in: Bool);
external PrintStrInt(str: String, in: Int);
external PrintStrIntInt(str: String, in1: Int, in2: Int);
external PrintStrBool(str: String, in: Bool);

diagramtype Main() {
    TestArithmetic_1;
	TestBoolean_1;
	TestComparison_1;
	TestSelectors_1;
}

diagramtype TestArithmetic {
	TestAdd_1;
	TestSub_1;
	TestDiv_1;
	TestMul_1;
	TestNeg_1;
	TestMod_1;
}

diagramtype TestBoolean {
	TestAnd_1;
	TestOr_1;
	TestXor_1;
	TestNot_1;
	TestMove_1;
}

diagramtype TestComparison {
	TestEq_1;
	TestNe_1;
	TestGe_1;
	TestGt_1;
	TestLe_1;
	TestLt_1;
}

diagramtype TestSelectors {
	TestMux_1;
	TestSelBool_1;
	TestSelInt_1;
	TestMax_1;
	TestMin_1;
}

//
// Arithmetic
//
diagramtype TestAdd {
    Add_1;
    p: PrintStrInt;

    connect(1, Add_1.in1);
    connect(2, Add_1.in2);
    connect("1+2 = ", p.str);
    connect(Add_1, p.in);
}

diagramtype TestSub {
    Sub_1;
    p: PrintStrInt;

    connect(1, Sub_1.in1);
    connect(2, Sub_1.in2);
    connect("1-2 = ", p.str);
    connect(Sub_1, p.in);
}


diagramtype TestDiv {
	Div_1;
	p1: PrintStrInt;
    
	Div_2;
	p2: PrintStrInt;

    connect(4, Div_1.in1);
    connect(2, Div_1.in2);
    connect("4/2 = ", p1.str);
    connect(Div_1, p1.in);

	connect(5, Div_2.in1);
	connect(0, Div_2.in2);
	connect("5/0 = ", p2.str);
	connect(Div_2, p2.in);
}

diagramtype TestMul {
    Mul_1;
    p: PrintStrInt;

    connect(3, Mul_1.in1);
    connect(6, Mul_1.in2);
    connect("3*6 = ", p.str);
    connect(Mul_1, p.in);
}

diagramtype TestNeg {
    Neg_1;
    p: PrintStrInt;

    connect(3, Neg_1.in);
    connect("-3 = ", p.str);
    connect(Neg_1, p.in);
}

diagramtype TestMod {
	Mod_1;
	p1: PrintStrInt;
    
	Mod_2;
	p2: PrintStrInt;

    connect(4, Mod_1.in1);
    connect(2, Mod_1.in2);
    connect("4%2 = ", p1.str);
    connect(Mod_1, p1.in);

	connect(5, Mod_2.in1);
	connect(2, Mod_2.in2);
	connect("5%2 = ", p2.str);
	connect(Mod_2, p2.in);
}


//
// Boolean
//
diagramtype TestAnd {
	And_1;
	And_2;
	And_3;
	p1: PrintStrBool;
	p2: PrintStrBool;
	p3: PrintStrBool;

	connect(true, And_1.in1);
	connect(true, And_1.in2);
	connect("true & true = ", p1.str);
	connect(And_1, p1.in);
	
	connect(false, And_2.in1);
	connect(true, And_2.in2);
	connect("false & true = ", p2.str);
	connect(And_2, p2.in);

	connect(false, And_3.in1);
	connect(false, And_3.in2);
	connect("false & false = ", p3.str);
	connect(And_3, p3.in);
}

diagramtype TestOr {
	Or_1;
	Or_2;
	Or_3;
	p1: PrintStrBool;
	p2: PrintStrBool;
	p3: PrintStrBool;

	connect(true, Or_1.in1);
	connect(true, Or_1.in2);
	connect("true | true = ", p1.str);
	connect(Or_1, p1.in);
	
	connect(false, Or_2.in1);
	connect(true, Or_2.in2);
	connect("false | true = ", p2.str);
	connect(Or_2, p2.in);

	connect(false, Or_3.in1);
	connect(false, Or_3.in2);
	connect("false | false = ", p3.str);
	connect(Or_3, p3.in);
}

diagramtype TestXor {
	Xor_1;
	Xor_2;
	Xor_3;
	p1: PrintStrBool;
	p2: PrintStrBool;
	p3: PrintStrBool;

	connect(true, Xor_1.in1);
	connect(true, Xor_1.in2);
	connect("true ^ true = ", p1.str);
	connect(Xor_1, p1.in);
	
	connect(false, Xor_2.in1);
	connect(true, Xor_2.in2);
	connect("false ^ true = ", p2.str);
	connect(Xor_2, p2.in);

	connect(false, Xor_3.in1);
	connect(false, Xor_3.in2);
	connect("false ^ false = ", p3.str);
	connect(Xor_3, p3.in);
}

diagramtype TestNot {
    Not_1;
    Not_2;
    p1: PrintStrBool;
    p2: PrintStrBool;

    connect(true, Not_1);
    connect("!true = ", p1.str);
    connect(Not_1, p1.in);

    connect(false, Not_2);
    connect("!false = ", p2.str);
    connect(Not_2, p2.in);
}


diagramtype TestMove {
    Move_1;
    p: PrintStrBool;

    connect(true, Move_1);
    connect("move true = ", p.str);
    connect(Move_1, p.in);
}


//
// Comparison
//
diagramtype TestEq {
	Eq_1;
	Eq_2;
	p1: PrintStrBool;
	p2: PrintStrBool;
	
	connect(3, Eq_1.in1);
	connect(3, Eq_1.in2);
	connect("3 == 3 = ", p1.str);
	connect(Eq_1, p1.in);
	
	connect(4, Eq_2.in1);
	connect(3, Eq_2.in2);
	connect("4 == 3 = ", p2.str);
	connect(Eq_2, p2.in);
}

diagramtype TestNe {
	Ne_1;
	Ne_2;
	p1: PrintStrBool;
	p2: PrintStrBool;
	
	connect(3, Ne_1.in1);
	connect(3, Ne_1.in2);
	connect("3 != 3 = ", p1.str);
	connect(Ne_1, p1.in);
	
	connect(4, Ne_2.in1);
	connect(3, Ne_2.in2);
	connect("4 != 3 = ", p2.str);
	connect(Ne_2, p2.in);
}

diagramtype TestGe {
	Ge_1;
	Ge_2;
	Ge_3;
	p1: PrintStrBool;
	p2: PrintStrBool;
	p3: PrintStrBool;
	
	connect(4, Ge_1.in1);
	connect(3, Ge_1.in2);
	connect("4 >= 3 = ", p1.str);
	connect(Ge_1, p1.in);

	connect(3, Ge_2.in1);
	connect(3, Ge_2.in2);
	connect("3 >= 3 = ", p2.str);
	connect(Ge_2, p2.in);
	
	connect(2, Ge_3.in1);
	connect(3, Ge_3.in2);
	connect("2 >= 3 = ", p3.str);
	connect(Ge_3, p3.in);
}

