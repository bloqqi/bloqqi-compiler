//
// Selectors
//
diagramtype TestMux {
	Mux3_1;
	Mux3_2;
	Mux3_3;
	Mux3_4;
	p1: PrintStrInt;
	p2: PrintStrInt;
	p3: PrintStrInt;
	p4: PrintStrInt;
	
	connect(1, Mux3_1.K);
	connect(2, Mux3_1.in1);
	connect(4, Mux3_1.in2);
	connect(6, Mux3_1.in3);
	connect("Mux(1, 2, 4, 6) = ", p1.str);
	connect(Mux3_1, p1.in);

	connect(2, Mux3_2.K);
	connect(2, Mux3_2.in1);
	connect(4, Mux3_2.in2);
	connect(6, Mux3_2.in3);
	connect("Mux(2, 2, 4, 6) = ", p2.str);
	connect(Mux3_2, p2.in);
	
	connect(3, Mux3_3.K);
	connect(2, Mux3_3.in1);
	connect(4, Mux3_3.in2);
	connect(6, Mux3_3.in3);
	connect("Mux(3, 2, 4, 6) = ", p3.str);
	connect(Mux3_3, p3.in);
	
	connect(1337, Mux3_4.K);
	connect(2, Mux3_4.in1);
	connect(4, Mux3_4.in2);
	connect(6, Mux3_4.in3);
	connect("Mux(1337, 2, 4, 6) = ", p4.str);
	connect(Mux3_4, p4.in);
}

diagramtype TestSelBool {
	SelBool_1;
	SelBool_2;
	p1: PrintStrBool;
	p2: PrintStrBool;
	
	connect(true, SelBool_1.sel);
	connect(true, SelBool_1.in1);
	connect(false, SelBool_1.in2);
	connect("SelBool(true, true, false) = ", p1.str);
	connect(SelBool_1, p1.in);

	connect(false, SelBool_2.sel);
	connect(true, SelBool_2.in1);
	connect(false, SelBool_2.in2);
	connect("SelBool(false, true, false) = ", p2.str);
	connect(SelBool_2, p2.in);
}

diagramtype TestSelInt {
	SelInt_1;
	SelInt_2;
	p1: PrintStrInt;
	p2: PrintStrInt;
	
	connect(true, SelInt_1.sel);
	connect(1, SelInt_1.in1);
	connect(2, SelInt_1.in2);
	connect("SelInt(true, 1, 2) = ", p1.str);
	connect(SelInt_1, p1.in);
	
	connect(false, SelInt_2.sel);
	connect(1, SelInt_2.in1);
	connect(2, SelInt_2.in2);
	connect("SelInt(false, 1, 2) = ", p2.str);
	connect(SelInt_2, p2.in);
}

diagramtype TestMax {
	Max_1;
	Max_2;
	p1: PrintStrIntInt;
	p2: PrintStrIntInt;
	
	connect(55, Max_1.in1);
	connect(-55, Max_1.in2);
	connect("Max(55, -55) = ", p1.str);
	connect(Max_1.max, p1.in1);
	connect(Max_1.index, p1.in2);

	connect(-55, Max_2.in1);
	connect(55, Max_2.in2);
	connect("Max(-55, 55) = ", p2.str);
	connect(Max_2.max, p2.in1);
	connect(Max_2.index, p2.in2);
}

diagramtype TestMin {
	Min_1;
	Min_2;
	p1: PrintStrIntInt;
	p2: PrintStrIntInt;
	
	connect(55, Min_1.in1);
	connect(-55, Min_1.in2);
	connect("Min(55, -55) = ", p1.str);
	connect(Min_1.min, p1.in1);
	connect(Min_1.index, p1.in2);

	connect(-55, Min_2.in1);
	connect(55, Min_2.in2);
	connect("Min(-55, 55) = ", p2.str);
	connect(Min_2.min, p2.in1);
	connect(Min_2.index, p2.in2);
}
