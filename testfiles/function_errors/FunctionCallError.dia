external E(in: Int => out: Int);
external E2(in: Int);

diagramtype Main {
  output out: Int;
  f: F;
  connect(5, f);
  connect(f, out);
}

function F(Int in => Int out)
{
  x1: Bool = Neg(in);
  x2: Bool = Neg(in) && true;
  x3: Int = Neg(true);
  x4: Int = Neg(1, 2, 3) + Mod(2);
  x5: Int = Neg(in) + Mod(in, false);
  x6: Int = Main(10);
  x7: Int = G(10);
  x8: Int = Max(10, 20);
  x9: Int = E(10);
  x10: Int = E2(10);
}
