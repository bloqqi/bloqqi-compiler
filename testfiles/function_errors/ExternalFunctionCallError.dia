external E(a: Int => out: Int);
external EB(a: Bool => out: Bool);
external E2(a: Int, b: Int => out: Int);

// A diagram type cannot be called. If it is called, then the types of its
// parameters are unknown.
diagramtype D(a: Bool => out: Bool) {
  connect(a, out);
}

function F(i: Int, b: Bool => out: Int) {
  Int x1 = E(b);
  Bool x2 = E(i);
  Int x3 = E2(i);
  Int x4 = E2(i, b);
  Int x5 = E(i, i);
  Bool x6 = EB(i);
  Int x7 = D(i);
  out = 0;
}
