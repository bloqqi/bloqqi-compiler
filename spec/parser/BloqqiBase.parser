CompilationUnit goal = 
	PACKAGE package_name.p SCOL
	import_decls.i?
	declarations.d? 				{: return new CompilationUnit(p.toString(), i, d); :}
	| import_decls.i?
	declarations.d? 				{: return new CompilationUnit("", i, d); :}
	;


VarUse package_name =
	simple_var_use.u				{: return u; :}
	| package_name.p DOT ID.id		{: return new DotVarUse(p, id); :}
	;

List import_decls =
	import_decl.d					{: return new List().add(d); :}
	| import_decls.l import_decl.d	{: return l.add(d); :}
	;

ImportDecl import_decl =
	IMPORT package_name.p DOT type_use.t SCOL
		{: return new ImportDecl(p.toString(), t); :}
	;

List declarations =
	  declaration.d					{: return new List().add(d); :}
	| declarations.l declaration.d	{: return l.add(d); :}
	;

Declaration declaration =
	  diagram_type.dt				{: return dt; :}
	| struct.s						{: return s; :}
	| external_function.e			{: return e; :}
	| recommendation.r				{: return r; :}
	;

DiagramType diagram_type =
	modifiers.m?
	DIAGRAMTYPE ID diagram_type_parameters.dt super_types
	LBRA
		vars.v? 
		component_list.c?
		flow_decls.fd?
	RBRA
	annotations.a?
	wiring.w?
	{:
		dt.setID(ID);
		dt.setModifiers(new Modifiers(m));
		dt.setSuperTypeList(super_types);
		dt.setLocalVariableList(v);
		dt.setLocalComponentList(c);
		dt.setFlowDeclList(fd);
		dt.setAnnotationList(a);
		dt.setLocalWiringOpt(w);
		return dt;
	:}
	;
	
List modifiers =
	modifier.m					{: return new List().add(m); :}
	| modifiers.l modifier.m	{: return l.add(m); :}
	;

Modifier modifier =
	ABSTRACT					{: return new Modifier("abstract"); :}
	| INLINE					{: return new Modifier("inline"); :}
	;
	
DiagramType diagram_type_parameters =
	LPAR in_pars.in? out_pars.out RPAR
	{: 
		DiagramType dt = new DiagramType();
		dt.setLocalInParameterList(in);
		dt.setLocalOutParameterList(out);
		return dt;
	:}
	| /* epsilon */		{: return new DiagramType(); :}
	;

List super_types =
									{: return new List(); :}
	| EXTENDS super_type_list.l		{: return l; :}
	;

List super_type_list =
	  type_use.t					{: return new List().add(t); :}
	| super_type_list.l COMMA type_use.t {: return l.add(t); :}
	;

List vars =
	  var.v SCOL                    {: return new List().add(v); :}
	| vars.l var.v SCOL				{: return l.add(v); :}
	;
	
Variable var =
	VARIABLE type_use.t ID.id		{: return new Variable(t, id); :}
	| VARIABLE ID.id COL type_use.t	{: return new Variable(t, id); :}
	;

List in_pars =
	  in_par.p						{: return new List().add(p); :}
	| in_pars.l COMMA in_par.p		{: return l.add(p); :}
	;
InParameter in_par =
	type_use.t ID.id				{: return new InParameter(t, id); :}
	| ID.id COL type_use.t			{: return new InParameter(t, id); :}
	;

List out_pars =
	  ARROW out_parlist.out			{: return out; :}
	|								{: return new List(); :}
	;

List out_parlist =
	  out_par.p						{: return new List().add(p); :}
	| out_parlist.l COMMA out_par.p	{: return l.add(p); :}
	;
OutParameter out_par =
	type_use.t ID.id				{: return new OutParameter(t, id); :}
	| ID.id COL type_use.t			{: return new OutParameter(t, id); :}
	;

List component_list =
	  component.c SCOL				{: return new List().add(c); :}
	| component_list.l component.c SCOL {: return l.add(c); :}
	;

List flow_decls =
	  flow_decl.f					{: return new List().add(f); :}
	| flow_decls.l flow_decl.f		{: return l.add(f); :}
	;

FlowDecl flow_decl =
	  connection.c SCOL				{: return c; :}
	| interception.i SCOL			{: return i; :}
	;

Component component =
	INLINE component2.c {:
		c.setInline(true);
		return c;
	:}
	| component2.c {: return c; :}
	;
	
Component component2 =
	ordinary_component.o			{: return o; :}
	| simple_component.s			{: return s; :}
	| redeclare_component.r			{: return r; :}
	| wired_component.w				{: return w; :}
	;

Component ordinary_component = 
	type.t name.n   {: return new Component(false, t, n, false); :}
	| name.n COL type.t {: return new Component(false, t, n, false); :}
	;

Component simple_component =
	ID.id
	{:
		int index = id.lastIndexOf('_');
		if (index > 0) {
			TypeUse t = new TypeUse(id.substring(0, index));
			Name n = new IdName(id);
			try {
				String i = id.substring(index+1);
				Integer.parseInt(i);
				return new Component(false, t, n, true);
			} catch (NumberFormatException e) {
				// fall through
			}
		}
		String errorMessage = 
			"Cannot parse simple component \"" + id + "\". " +
			"Correct syntax: TypeName_Index, where Index is a number";
		throw new BloqqiScanner.ScannerError(errorMessage);
	:}
	;


Name name =
	ID.id							{: return new IdName(id); :}
	;

RedeclareComponent redeclare_component =
	REDECLARE type.t name.n
	  {: return new RedeclareComponent(false, t, n, false); :}
	| REDECLARE name.n COL type.t
	  {: return new RedeclareComponent(false, t, n, false); :}
	| REDECLARE name.n COL SUPER anon_dt_body.a
	  {: return new RedeclareComponent(false, new AnonymousTypeImplicitSuper(a), n, false); :}
	;

WiredComponent wired_component =
	type_use.t LSQUAREBRA wired_comp_pars.p RSQUAREBRA name.n
	  {: return new WiredComponent(false, t, n, false, p); :}
	| type_use.t LSQUAREBRA wired_comp_pars.p RSQUAREBRA anon_dt_body.b name.n
	  {:
		b.addSuperType(t);
		return new WiredComponent(false, new AnonymousType(b), n, false, p);
	  :}
	| name.n COL type_use.t LSQUAREBRA wired_comp_pars.p RSQUAREBRA
	  {: return new WiredComponent(false, t, n, false, p); :}
	| name.n COL type_use.t LSQUAREBRA wired_comp_pars.p RSQUAREBRA anon_dt_body.b
	  {:
		b.addSuperType(t);
		return new WiredComponent(false, new AnonymousType(b), n, false, p);
	  :}
	;

List wired_comp_pars =
	wired_comp_par.p               {: return new List().add(p); :}
	| wired_comp_pars.l COMMA wired_comp_par.p {: return l.add(p); :}
	;

WiredComponentParameter wired_comp_par =
	in_par.in	                    {: return new WiredComponentParameterInParameter(in); :}
	| ARROW out_par.out             {: return new WiredComponentParameterOutParameter(out); :}
	| var_use.u                     {: return new WiredComponentParameterVarUse(u); :}
	;

Connection connection =
	  CONNECT LPAR 
	  expr.e COMMA var_use.u 
	  RPAR  						{: return new Connection(e, u); :}
	;

Interception interception =
	  INTERCEPT var_use.i WITH var_use.t COMMA var_use.s
									{: return new ConnectionInterception(i, t, s); :}
	| INTERCEPT SOURCE var_use.i WITH var_use.t COMMA var_use.s
									{: return new SourceInterception(i, t, s); :}
	;

Struct struct = 
	  STRUCT ID LBRA
	  fields.l?
	  RBRA							{: return new Struct(ID, l); :}
	;

List fields =
	  field.f SCOL					{: return new List().add(f); :}
	| fields.l field.f SCOL			{: return l.add(f); :}
	;

StructField field =
	  type_use.t ID					{: return new StructField(t, ID); :}
	| ID COL type_use.t 			{: return new StructField(t, ID); :}
	;

Type type =
	type_use.u						{: return u; :}
	| anon_dt.a						{: return new AnonymousType(a); :}
	;

TypeUse type_use =
	  ID							{: return new TypeUse(ID); :}
	;

AnonymousDiagramType anon_dt =
	type_use.t anon_dt_body.a
	{:
		a.addSuperType(t);
		return a;
	:}
	;

AnonymousDiagramType anon_dt_body =
	diagram_type_parameters.dt
	LBRA
		vars.v?
		component_list.c?
		flow_decls.fd?
	RBRA
	{:
		AnonymousDiagramType adt = new AnonymousDiagramType();
		adt.setLocalInParameterList(dt.getLocalInParameterList());
		adt.setLocalOutParameterList(dt.getLocalOutParameterList());
		adt.setID("<anonymous>");
		adt.setModifiers(new Modifiers());
		adt.setLocalVariableList(v);
		adt.setLocalComponentList(c);
		adt.setFlowDeclList(fd);
		return adt;
	:}
	;


Expr expr =
	  var_use.u						{: return u; :}
	| real_lit.r					{: return r; :}
	| int_lit.i						{: return i; :}
	| bool_lit.b					{: return b; :}
	| string_lit.s					{: return s; :}
	;

IntLiteral int_lit =
	  NUM.n							{: return new IntLiteral(Integer.valueOf(n)); :}
	;
	
RealLiteral real_lit =
	  FLOAT.f			    	    {: return new RealLiteral(Float.valueOf(f)); :}
	;

BoolLiteral bool_lit =
	TRUE							{: return new BoolLiteral(true); :}
	| FALSE							{: return new BoolLiteral(false); :}
	;

StringLiteral string_lit =
	STRING_LITERAL.s				{: return new StringLiteral(s); :}
	;

VarUse var_use =
	type_use.t DOUBLECOL ID.id		{: return new ParseTypedSimpleVarUse(t, id); :}
	| var_use.u DOT ID.id			{: return new DotVarUse(u, id); :}
	| ID.id							{: return new ParseSimpleVarUse(id); :}
	;

SimpleVarUse simple_var_use =
	  ID.id							{: return new SimpleVarUse(id); :}
	;


ExternalFunction external_function =
	  EXTERNAL ID LPAR in_pars.in? external_function_output.out RPAR SCOL
	  								{: return new ExternalFunction(ID, in, out); :}
	;

Opt external_function_output =
	  ARROW out_par.out				{: return new Opt(out); :}
	|								{: return new Opt(); :}
	;

List annotations = 
	  ANNOTATION LPAR
	  	annotation_list.l? COMMA?
	  RPAR							{: return l; :}
	;
List annotation_list =
	  annotation.a 					{: return new List().add(a); :}
	| annotation_list.l COMMA annotation.a {: return l.add(a); :}
	;
Annotation annotation =
	  var_use.v ASSIGN LPAR
	  	NUM.x COMMA
	  	NUM.y COMMA
	  	NUM.w COMMA
	  	NUM.h
	  RPAR	
	  {: int xi = Integer.valueOf(x);
	  	 int yi = Integer.valueOf(y);
	  	 int wi = Integer.valueOf(w);
	  	 int hi = Integer.valueOf(h);
	 	 return new Annotation(v, xi, yi, wi, hi); 
	  :}
	;
	
Wiring wiring =
	WIRING type_use.t LSQUAREBRA wiring_par_list.p RSQUAREBRA LBRA
		flow_decls.fd
	RBRA
    {: return new Wiring(t, p, fd); :}
	;

List wiring_par_list =
	wiring_par.p                   {: return new List().add(p); :}
	| wiring_par_list.l COMMA wiring_par.p {: return l.add(p); :}
	;
WiringParameter wiring_par =
	type_use.u ID                   {: return new WiringInParameter(u, ID); :}
	| ARROW type_use.u ID           {: return new WiringOutParameter(u, ID); :}
	| ID COL type_use.u             {: return new WiringInParameter(u, ID); :}
	| ARROW ID COL type_use.u       {: return new WiringOutParameter(u, ID); :}
	;

Declaration recommendation =
	RECOMMENDATION type_use.t LBRA
		recommendation_elems.l?
	RBRA
		{: return new Recommendation(t, l); :}
	| RECOMMENDATION type_use.t EXTENDS SUPER SCOL
		{: return new RecommendationExtendsSuper(t); :}
	;
	
List recommendation_elems =
	recommendation_elem.c SCOL								{: return new List().add(c); :}
	| recommendation_elems.l recommendation_elem.c SCOL {: return l.add(c); :}
	;
	
RecommendationElement recommendation_elem =
	recommendation_component.c
		{: return new RecommendationComponent(c); :}
	| INLINE recommendation_component.c
		{: c.setInline(true); return new RecommendationComponent(c); :}
	| REPLACEABLE simple_var_use.use
		{: return new RecommendationReplaceable(use); :}
	| simple_var_use.u1 BEFORE simple_var_use.u2
		{: return new RecommendationBefore(u1, u2); :}
	;

Component recommendation_component =
	wired_component.w				{: return w; :}
	| ordinary_component.o			{: return o; :}
	;