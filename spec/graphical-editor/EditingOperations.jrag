import java.io.StringReader;

aspect EditingOperations {
	syn boolean Connection.canDelete() = !isInherited();
	eq InlinedConnection.canDelete() {
		if (getDeclaredFlowDecl().diagramType() != diagramType()) {
			return false;
		}
		if (getSource().node() == null || getTarget().node() == null) {
			return false;
		}
		if (getSource().node().isInlined() && getTarget().node().isInlined()) {
			// Connections between two blocks belonging to two different inlined blocks can be deleted
			return getSource().node().inlinedBlock() != getTarget().node().inlinedBlock();
		} else {
			return true;
		}
	}
	syn boolean Node.canDelete() = !isInherited() && !isInlined();


	public static boolean Program.isIdValid(String name) {
		BloqqiScanner scanner = new BloqqiScanner(new StringReader(name));
		try {
			beaver.Symbol sym1 = scanner.nextToken();
			beaver.Symbol sym2 = scanner.nextToken();
			return sym1.getId() == BloqqiParser.Terminals.ID
					&& sym2.getId() == BloqqiParser.Terminals.EOF;
		} catch (Throwable t) {
		}
		return false;
	}
	
	public static Literal Program.parseLiteral(String value) {
		BloqqiScanner scanner = new BloqqiScanner(new StringReader(value));
		try {
			beaver.Symbol sym1 = scanner.nextToken();
			beaver.Symbol sym2 = scanner.nextToken();
			if (sym2.getId() != BloqqiParser.Terminals.EOF) {
				return null;
			}
			if (sym1.getId() == BloqqiParser.Terminals.TRUE) {
				return new BoolLiteral(true);
			} else if (sym1.getId() == BloqqiParser.Terminals.FALSE) {
				return new BoolLiteral(false);
			} else if (sym1.getId() == BloqqiParser.Terminals.NUM) {
				return new IntLiteral(Integer.valueOf((String) sym1.value));
			} else if (sym1.getId() == BloqqiParser.Terminals.FLOAT) {
				return new RealLiteral(Float.valueOf((String) sym1.value));
			} else if (sym1.getId() == BloqqiParser.Terminals.STRING_LITERAL) {
				return new StringLiteral((String) sym1.value);
			}
			return null;
		} catch (Throwable t) {
		}
		return null;
	}
}


aspect AddParametersAndConnections {
	public Pair<Block, VarUse> DiagramType.addConnectionsParameters(
			String path, String parameterName) {
		return addConnectionsParameters(path, false, parameterName);
	}
	
	public VarUse DiagramType.addConnectionsParametersToDiagramType(
			String path, String parameterName) {
		Pair<Block, VarUse> p = addConnectionsParameters(path, true, parameterName);
		return p.second;
	}
	
	public Pair<Block, VarUse> DiagramType.addConnectionsParameters(
			String path, boolean addToDiagramType, String parameterName) {
		String parts[] = path.split("\\.");
		if (parts.length < 3 ) {
			throw new RuntimeException("The path " + path + " needs to have at least 3 parts");
		}
		
		Block current = localBlockLookup(parts[0]);
		if (current == null) {
			throw new RuntimeException("Could not find block " + parts[0] + " in " + path);
		}
		Block outerBlock = current;
		for (int i = 1; i < parts.length-2; i++) {
			if (current.anonymousDiagramType() == null) {
				throw new RuntimeException("Block " + parts[i] + " in " + path + " needs to have an anonyous type");
			}
			current = current.anonymousDiagramType().localBlockLookup(parts[i]);
			if (current == null) {
				throw new RuntimeException("Could not find block " + parts[i] + " in " + path);
			}
		}
		Block innerBlock = current;
		
		VarDecl vdComp = innerBlock.type().lookup(parts[parts.length-2]);
		if (!(vdComp instanceof Block)) {
			throw new RuntimeException("Could not find block " + parts[parts.length-2] + " in " + path);
		}
		Block innerInner = (Block) vdComp;
		
		VarDecl vdPort = innerInner.findMember(parts[parts.length-1]);
		if (!(vdPort instanceof Port)) {
			throw new RuntimeException("Could not find block " + parts[parts.length-1] + " in " + path);
		}
		Port port = (Port) vdPort;
		
		String portName = addToDiagramType ? null : parameterName;
		Pair<Block, VarUse> p = ASTNode.addConnectionsParameters(outerBlock, innerBlock, port, portName);
		Pair<Block, VarUse> result;
		if (addToDiagramType) {
			//String parameterName = getUniqueName(outerBlock.name() + port.name());
			addParameter(parameterName, port);
			addConnection(new SimpleVarUse(parameterName), p.second, port.isInParameter());
			result = new Pair<>(p.first, new SimpleVarUse(parameterName));
		} else {
			result = new Pair<>(p.first, p.second);
		}
		getLocalBlockList().setChild(p.first, getLocalBlockList().getIndexOfChild(outerBlock));
		program().flushAllAttributes();
		
		return result;
	}

	/**
	 * See test cases for how to use this method
	 * The parameter outerParameterName can be null, then this name will be computed
	 */
	public static Pair<Block, VarUse> ASTNode.addConnectionsParameters(
			Block outerBlock,
			Block innerEnclosingBlock,
			Port port,
			String outerParameterName) {
		if (!innerEnclosingBlock.isEnclosedBy(outerBlock)) {
			throw new RuntimeException("Block " +  innerEnclosingBlock
					+ " + is not enclosed by block " + outerBlock.name());
		}
		// TODO: Do sanity check on port
		
		// Add the related blocks in list
		ArrayList<Block> blocks = new ArrayList<>();
		blocks.add(port.block().declaredBlock());
		Block current = innerEnclosingBlock;
		while (current != outerBlock) {
			blocks.add(current.declaredBlock());
			current = current.enclosingBlock();
		}
		blocks.add(outerBlock.declaredBlock());
	
		
		// Iterate over the anonymous types/blocks from inside out
		// and modify the blocks by creating a new copy of them.
		Block lastNewBlock = null;
		int lastIndex = -1;
		String lastParameterName = port.name();
		
		Iterator<Block> itr = blocks.iterator();
		Block block = itr.next();
		Block enclosingBlock = itr.next();
		while (enclosingBlock != null) {
			Block newBlock = enclosingBlock.treeCopy();
			
			// Parameter name
			String parameterName;
			if (outerParameterName != null && enclosingBlock == outerBlock.declaredBlock()) {
				parameterName = outerParameterName;
			} else {
				parameterName = enclosingBlock.anonymousDiagramType()
					.getUniqueName(block.name() + port.name());
			}
			
			// Add new parameter
			newBlock.anonymousDiagramType().addParameter(parameterName, port);
	
			// Create connection
			newBlock.anonymousDiagramType().addConnection(
					new SimpleVarUse(parameterName),
					new DotVarUse(new SimpleVarUse(block.name()), lastParameterName),
					port.isInParameter());
			
			// Add previous created block to current block
			if (lastNewBlock != null) {
				AnonymousDiagramType adt = newBlock.anonymousDiagramType();
				adt.setLocalBlock(lastNewBlock, lastIndex);
			}
			
			lastNewBlock = newBlock;
			lastIndex = enclosingBlock.getParent().getIndexOfChild(enclosingBlock);
			lastParameterName = parameterName;
			
			block = enclosingBlock;
			if (itr.hasNext()) {
				enclosingBlock = itr.next();
			} else {
				enclosingBlock = null;
			}
		}
	
		VarUse varUse = new DotVarUse(
				new SimpleVarUse(block.name()),
				lastParameterName);
		return new Pair<>(lastNewBlock, varUse);
	}
	
	public String DiagramType.getUniqueName(String name) {
		String newName = name;
		int i = 2;
		while (lookup(newName) != null) {
			newName = name + i;
			i++;
		}
		return newName;
	}
	
	public void DiagramType.addParameter(String parameterName, Port port) {
		if (port.isInParameter()) {
			InParameter inParameter = new InParameter(
				port.getParameter().getTypeUse().treeCopy(),
				parameterName);
			addLocalInParameter(inParameter);
		} else {
			OutParameter outParameter = new OutParameter(
				port.getParameter().getTypeUse().treeCopy(),
				parameterName);
			addLocalOutParameter(outParameter);
		}
	}
	
	public void DiagramType.addConnection(VarUse parameterUse, VarUse portUse, boolean isInParameter) {
		Connection newConn;
		if (isInParameter) {
			newConn = new Connection(parameterUse, portUse);
		} else {
			newConn = new Connection(portUse, parameterUse);
		}
		addFlowDecl(newConn);
	}
}

aspect AddAnonymousTypes {
	public static Block Block.addAnonymousTypesForNestedBlocks(Iterable<Block> nestedBlocks) {
		if (!allBlocksNested(nestedBlocks)) {
			throw new RuntimeException("The blocks " + nestedBlocks + " are not nested");
		}
		
		Block newBlock;
		Block enclosingBlock;
		
		// Replace the outermost block first
		Iterator<Block> itr = nestedBlocks.iterator();
		Block firstBlock = itr.next();
		if (firstBlock.hasAnonymousDiagramType()) {
			newBlock = firstBlock.treeCopy();
			enclosingBlock = newBlock;
		} else {
			newBlock = firstBlock.createOutermostBlock();
			enclosingBlock = newBlock;
		}
		
		// Replace the inner blocks (if needed)
		// Keep track of the enclosing block
		DiagramType enclosingType = firstBlock.diagramType();
		while (itr.hasNext()) {
			Block block = itr.next();
			if (!block.diagramType().isEnclosedBy(enclosingType)) {
				RedeclareBlock rb = block.createRedeclareBlock();
				enclosingBlock.anonymousDiagramType().addLocalBlock(rb);
				enclosingBlock = rb;
			} else {
				Block innerBlock = enclosingBlock.anonymousDiagramType()
						.localBlockLookup(block.name());
				if (!block.hasAnonymousDiagramType()) {
					innerBlock.setType(block.createAnonymousType());
				}
				enclosingBlock = innerBlock;
			}
		}
		
		return newBlock;
	}
	
	/**
	 * Check if the blocks are nested inside each other,
	 * Thus, the second block should be a member of the first block's type,
	 *       the third block should be a member of the second block's type, etc.
	 */
	protected static boolean Block.allBlocksNested(Iterable<Block> nestedBlocks) {
		Iterator<Block> itr = nestedBlocks.iterator();
		Block enclosingBlock = itr.next();
		while (itr.hasNext()) {
			Block currentBlock = itr.next();
			if (enclosingBlock.type().lookup(currentBlock.name()) == null) {
				return false;
			}
			enclosingBlock = currentBlock;
		}
		return true;
	}

	protected RedeclareBlock Block.createRedeclareBlock() {
		RedeclareBlock rb = new RedeclareBlock();
		rb.setName(getName().treeCopy());
		rb.setModifiers(new Modifiers());
		AnonymousDiagramType anonDt = new AnonymousDiagramType();
		anonDt.setModifiers(new Modifiers());
		AnonymousTypeImplicitSuper anonType = new AnonymousTypeImplicitSuper(anonDt);
		rb.setType(anonType);
		return rb;
	}

	protected AnonymousType Block.createAnonymousType() {
		AnonymousDiagramType anonDt = new AnonymousDiagramType();
		anonDt.setModifiers(new Modifiers());
		anonDt.addSuperType((TypeUse) getType().treeCopy());
		return new AnonymousType(anonDt);
	}

	protected Block Block.createOutermostBlock() {
		Block newBlock = treeCopy();
		newBlock.setType(createAnonymousType());
		return newBlock;
	}
}

