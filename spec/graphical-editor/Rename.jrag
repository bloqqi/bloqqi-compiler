aspect Rename {
	public boolean UserDefType.changeName(String newName) {
		if (lookupType(newName) != null) {
			return false;
		}
		for (TypeUse use: uses()) {
			use.changeName(newName);
		}
		setID(newName);
		program().flushAllAttributes();
		return true;
	}
	
	inh Block TypeUse.block();
	eq Block.getType().block() = this;
	eq Program.getChild().block() = null;
	inh Wiring TypeUse.wiring();
	eq Wiring.getTypeUse().wiring() = this;
	eq Program.getChild().wiring() = null;
	public void TypeUse.changeName(String newName) {
		if (block() != null) {
			block().updateTypeName(newName);
		}
		if (wiring() != null) {
			wiring().block().changeName(newName, false);
		}
		setID(newName);
	}
	public void Block.updateTypeName(String newName) {
		if (getModifiers().isOnSimpleNameForm()) {
			String name = getName().toString();
			String index = name.substring(name.lastIndexOf('_')+1);
			String newFullName = newName + "_" + index;
			if (getName() instanceof IdName) {
				((IdName)getName()).setID(newFullName);
			}
			for (VarUse use: uses()) {
				use.changeName(newFullName);
			}
		}
	}
	

	public interface Node {
		boolean changeName(String newName);
	}
	
	public boolean VarDecl.changeName(String newName) {
		if (lookup(newName) != null) {
			return false;
		}
		changeUses(newName);
		setNewIdToken(newName);
		program().flushAllAttributes();
		return true;
	}
	
	protected void VarDecl.setNewIdToken(String id) {
		throw new UnsupportedOperationException();
	}
	protected void Parameter.setNewIdToken(String id) {
		setID(id);
	}
	protected void Variable.setNewIdToken(String id) {
		setID(id);
	}
	
	public boolean Block.changeName(String newName) {
		return changeName(newName, true);
	}
	protected boolean Block.changeName(String newName, boolean flush) {
		if (lookup(newName) != null) {
			return false;
		}
		changeUses(newName);
		setName(new IdName(newName));
		getModifiers().removeModifier(ASTNode.MODIFIER_SIMPLE);
		if (flush) {
			program().flushAllAttributes();
		}
		return true;
	}
	
	public boolean Literal.changeName(String newName) {
		throw new UnsupportedOperationException();
	}
	
	
	protected void VarDecl.changeUses(String newName) {
		for (VarUse use: uses()) {
			use.changeName(newName);
		}
	}
	
	public abstract void VarUse.changeName(String newName);
	public void AbstractSimpleVarUse.changeName(String newName) {
		setID(newName);
	}
	public void TypedSimpleVarUse.changeName(String newName) {
		setID(newName);
	}
	public void DotVarUse.changeName(String newName) {
		setID(newName);
	}
}

aspect NameUses {
	coll Set<TypeUse> TypeDecl.uses() [new HashSet<TypeUse>()] with add;
	TypeUse contributes this
		when decl() != null
		to TypeDecl.uses() for decl();

	coll Set<VarUse> VarDecl.uses() [new HashSet<VarUse>()] with add;
	VarUse contributes this
		when decl() != null
		to VarDecl.uses() for decl();
	VarUse contributes this
		when decl() instanceof Port
		to VarDecl.uses() for decl().declaredParameter();

	syn Parameter VarDecl.declaredParameter();
	eq Port.declaredParameter() = getParameter().declaredParameter();
	eq Parameter.declaredParameter() = this;
	eq InheritedInParameter.declaredParameter() = getDeclaredInParameter();
	eq InheritedOutParameter.declaredParameter() = getDeclaredOutParameter();
	eq Variable.declaredParameter() = null;
	eq Block.declaredParameter() = null;
	eq StructField.declaredParameter() = null;
}
