import java.io.InputStreamReader;
aspect StandardLibrary {
	public static CompilationUnit Program.loadStandardLibrary() throws Exception {
		InputStream is = Program.class.getResourceAsStream("/bloqqi/StandardFunctions.dia");
		BloqqiScanner scanner = new BloqqiScanner(new InputStreamReader(is));
		BloqqiParser parser = new BloqqiParser();
		CompilationUnit stdLib = (CompilationUnit) parser.parse(scanner);
		return stdLib;
	}
}