Program ::= CompilationUnit* [StandardLibrary:CompilationUnit];
CompilationUnit ::= <PackageName> ImportDecl* Declaration*;
ImportDecl ::= <PackageName> TypeUse;

/** VarDecl */
abstract VarDecl;

/** Declarations */
abstract Declaration;
abstract TypeDecl : Declaration;
abstract UserDefType : TypeDecl ::= [DocString] <ID>;
DiagramType : UserDefType ::=
	Modifiers
	FeatureUse*
	LocalInParameter:InParameter* LocalOutParameter:OutParameter* SuperType:TypeUse*
	LocalVariable:Variable* LocalBlock:Block* FlowDecl* Annotation*
	[LocalWiring:Wiring]
	/InParameter:InheritedInParameter*/ /OutParameter:InheritedOutParameter*/ /Variable:InheritedVariable*/
	/Block:InheritedBlock*/ /Connection:InheritedConnection*/
	/RecommendationGroup*/
	;
AnonymousDiagramType : DiagramType;
ExternalFunction : UserDefType ::= InParameter* [OutParameter];
Struct : UserDefType ::= StructField*;
StructField : VarDecl ::= TypeUse <ID>;
abstract PrimitiveType : TypeDecl;
IntType : PrimitiveType;
RealType : PrimitiveType;
BoolType : PrimitiveType;
StringType : PrimitiveType;
UnknownType : TypeDecl;

DocString ::= Doc:StringLiteral;

/** Types */
abstract Type;
TypeUse: Type ::= <ID>;
AnonymousType : Type ::= AnonymousDiagramType;
AnonymousTypeImplicitSuper : AnonymousType;

/** Parameters */
abstract Parameter : VarDecl ::= TypeUse <ID>;
InParameter : Parameter;
InheritedInParameter : InParameter ::= <DeclaredInParameter:InParameter>;
OutParameter : Parameter;
InheritedOutParameter : OutParameter ::= <DeclaredOutParameter:OutParameter>;

/** Blocks */
Block : VarDecl ::=
	Modifiers
	Type
	Name
	/InPort:Port*/
	/OutPort:Port*/;
RedeclareBlock : Block;
WiredBlock : Block ::= WiredBlockParameter*;
abstract WiredBlockParameter;
WiredBlockParameterVarUse : WiredBlockParameter ::= VarUse;
WiredBlockParameterInParameter : WiredBlockParameter ::= InParameter;
WiredBlockParameterOutParameter : WiredBlockParameter ::= OutParameter;
InheritedBlock : Block ::= <DeclaredBlock:Block>;
InlinedBlock : InheritedBlock ::=
	<InlinedBlocks:java.util.List<Block>>
	<LastDiagramType:DiagramType>;

abstract Name;
IdName : Name ::= <ID>;
InlinedName : Name ::= Outer:Name Inner:Name;
Port : VarDecl ::= <Parameter:Parameter>;

/** Variables */
abstract Variable : VarDecl ::= TypeUse <ID>;
StateVariable : Variable;
InputVariable : Variable;
OutputVariable : Variable;
InheritedVariable : Variable ::= <DeclaredVariable:Variable>;
InlinedVariable : InheritedVariable ::= <InlinedBlock:Block>;

/** Flow declarations */
abstract FlowDecl;
Connection : FlowDecl ::= Source:Expr Target:VarUse;
InheritedConnection : Connection ::= <DeclaredFlowDecl:FlowDecl>;
InlinedConnection : InheritedConnection ::= <InlinedBlock:Block>;
InterceptConnection : InheritedConnection ::= <IsFirstConnection:Boolean>;
abstract Interception : FlowDecl ::= Intercepted:VarUse Target:VarUse Source:VarUse;
ConnectionInterception : Interception;
SourceInterception : Interception;

/** Expressions */
abstract Expr;
abstract Literal : Expr;
IntLiteral : Literal ::= <Value:int>;
RealLiteral : Literal ::= <Value:float>;
BoolLiteral : Literal ::= <Value:boolean>;
StringLiteral : Literal ::= <Value>;
MultiLineStringLiteral : StringLiteral;
abstract VarUse : Expr;
abstract AbstractSimpleVarUse : VarUse ::= <ID>;
ParseSimpleVarUse : AbstractSimpleVarUse;
ParseTypedSimpleVarUse : ParseSimpleVarUse ::= TypeUse <ID>;
SimpleVarUse : AbstractSimpleVarUse;
TypedSimpleVarUse : SimpleVarUse ::= TypeUse <ID>;
DotVarUse : VarUse ::= VarUse <ID>;

/** Wirings */
Wiring ::= TypeUse WiringParameter* FlowDecl*;
abstract WiringParameter : VarDecl ::= TypeUse <ID>;
WiringInParameter : WiringParameter;
WiringOutParameter : WiringParameter;

/** Recommendations */
Recommendation : Declaration ::= DeclaredForType:TypeUse RecommendationElement*;
abstract RecommendationElement;
RecommendationBlock : RecommendationElement ::= Block [Default:TypeUse];
RecommendationBefore : RecommendationElement ::= BeforeVarUse:SimpleVarUse AfterVarUse:SimpleVarUse;
RecommendationReplaceable : RecommendationElement ::= SimpleVarUse;
RecommendationExtendsSuper : Declaration ::= DeclaredForType:TypeUse;
RecommendationGroup : VarDecl ::= <Name>;

/** Modifiers */
Modifiers ::= Modifier*;
Modifier ::= <Name:String>;

/** Annotations */
Annotation ::= VarUse <X:int> <Y:int> <Width:int> <Height:int>;
