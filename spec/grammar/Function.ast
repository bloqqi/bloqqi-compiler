Function : UserDefType ::= InParameter* OutParameter* BlockStmt;

abstract Stmt;
AssignStmt : Stmt ::= Left:IdFExpr Right:FExpr;
BlockStmt : Stmt ::= Stmt*;
DeclStmt : Stmt ::= TypeUse <ID> [FExpr];
IfStmt : Stmt ::= FExpr BlockStmt [Else:BlockStmt];
WhileStmt : Stmt ::= FExpr BlockStmt;
ReturnStmt : Stmt;

abstract FExpr;
IdFExpr : FExpr ::= <ID>;
abstract UnaryFExpr : FExpr ::= FExpr;
NotFExpr : UnaryFExpr ::= FExpr;
MinusFExpr : UnaryFExpr ::= FExpr;
IntLiteralFExpr : FExpr ::= <Num>;
BoolLiteralFExpr : FExpr ::= <Value:boolean>;
RealLiteralFExpr : FExpr ::= <Float>;
abstract BinFExpr : FExpr ::= Left:FExpr Right:FExpr;
BoolBinFExpr : BinFExpr;
IntBinFExpr : BinFExpr;
AddFExpr : IntBinFExpr;
SubFExpr : IntBinFExpr;
MulFExpr : IntBinFExpr;
DivFExpr : IntBinFExpr;
ModFExpr : IntBinFExpr;
GEFExpr	 : BoolBinFExpr;
GTFExpr  : BoolBinFExpr;
LEFExpr  : BoolBinFExpr;
LTFExpr  : BoolBinFExpr;
EqFExpr  : BoolBinFExpr;
NEqFExpr : BoolBinFExpr;
AndFExpr : BoolBinFExpr;
OrFExpr  : BoolBinFExpr;

