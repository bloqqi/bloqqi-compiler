/** Features */
Features : Declaration ::= TypeUse FeatureStmt*;
abstract FeatureStmt;
FeatureDeclStmt : FeatureStmt ::= <ID> TypeUse;
FeatureExcludesStmt : FeatureStmt ::= First:FeatureIdUse Second:FeatureIdUse;
FeatureBeforeStmt : FeatureStmt ::= Before:FeatureIdUse After:FeatureIdUse;
FeatureIdUse ::= <ID>;

FeatureUse ::= FeatureIdUse;
