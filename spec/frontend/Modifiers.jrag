aspect Modifiers {
	// Synthetical modifier that is created by the parser to represent
	// blocks with name like "Add_1".
	public static final String ASTNode.MODIFIER_SIMPLE = "simple";

	inh boolean Modifiers.canBeAbstract();
	inh boolean Modifiers.canBeInline();
	inh boolean Modifiers.canBeOnSimpleNameForm(); // represents Add_1 etc.

	eq Program.getChild().canBeAbstract() = false;
	eq Program.getChild().canBeInline() = false;
	eq Program.getChild().canBeOnSimpleNameForm() = false;
	
	eq DiagramType.getModifiers().canBeAbstract() = true;
	eq Block.getModifiers().canBeInline() = true;
	eq Block.getModifiers().canBeOnSimpleNameForm() = true;

	syn boolean Modifiers.isAbstract() = hasModifier("abstract");
	syn boolean Modifiers.isInline() = hasModifier("inline");
	syn boolean Modifiers.isOnSimpleNameForm() = hasModifier(ASTNode.MODIFIER_SIMPLE);
}	

aspect AnalyzeModifiers {
	syn boolean Modifiers.hasModifier(String name) 
		= localModifierLookup(name) != null;
	syn Modifier Modifiers.localModifierLookup(String name) {
		for (Modifier m: getModifiers()) {
			if (m.getName().equals(name)) {
				return m;
			}
		}
		return null;
	}
	
	inh Modifier Modifier.lookupModifier(String name);
	eq Modifiers.getModifier().lookupModifier(String name)
		= localModifierLookup(name);
	
	syn boolean Modifier.isRepeatedModifier()
		= lookupModifier(getName()) != this;
}

aspect ModifiersOperations {
	public boolean Modifiers.removeModifier(String modifier) {
		ArrayList<Modifier> remove = new ArrayList<Modifier>();
		for (Modifier m: getModifiers()) {
			if (m.getName().equals(modifier)) {
				remove.add(m);
			}
		}
		if (remove.isEmpty()) {
			return false;
		} else {
			for (Modifier m: remove) {
				getModifiers().removeChild(m);
			}
			return true;
		}
	}
	
	public void Modifiers.addModifier(String modifier) {
		if (localModifierLookup(modifier) == null) {
			addModifier(new Modifier(modifier));
		}
	}
	
	public void Modifiers.setModifier(String modifierName, boolean setModifier) {
		if (setModifier) {
			addModifier(modifierName);
		} else {
			removeModifier(modifierName);
		}
	}
}

aspect ModifiersErrors {
	syn String Modifiers.errorMessage() {
		StringJoiner joiner = new StringJoiner(", ");
		if (isAbstract() && !canBeAbstract()) {
			joiner.add("abstract");
		}
		if (isInline() && !canBeInline()) {
			joiner.add("inline");
		}
		
		if (joiner.length() == 0) {
			return "";
		} else {
			return context().kindDescription() 
				+ "s are not allowed to have the modifiers: " 
				+ joiner.toString();
		}
	}
	
	inh ASTNode Modifiers.context();
	eq DiagramType.getModifiers().context() = this;
	eq Block.getModifiers().context() = this;
	syn String ASTNode.kindDescription() = "";
	eq DiagramType.kindDescription() = "Diagram type";
	eq Block.kindDescription() = "Block";
	
	Modifiers contributes context().error(errorMessage())
		when !errorMessage().isEmpty()
		to CompilationUnit.errors();
		
	Modifier contributes error("Repeated modifier: " + getName())
		when isRepeatedModifier()
		to CompilationUnit.errors();
}