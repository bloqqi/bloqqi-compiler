import java.util.Stack;

/** 
 * This modules transforms cyclic dataflow graphs into acyclic dataflow graphs
 * by removing edges based on the declaration order of components. The acyclic dataflow
 * graph is used to compute the execution order.
 * 
 * Cycles in the dataflow graph are found by computing the strongly connected components
 * (SCCs) using Robert Tarjan's algorithm. Within a SCC, edges are removed based on the 
 * position order (that is, the declaration order/layout order) of the components to
 * remove cycles in an iterative manner.
 */
aspect Cycles {
	public class SCC extends TreeSet<Component> {}
	public class SCCList extends ArrayList<SCC> {}
	
	public SCCList DiagramType.scc() {
		Map<Component, Set<Component>> succ = new HashMap<>();
		for (Component c: components()) {
			succ.put(c, c.succ());
		}
		return scc(succ);
	}
	
	public SCCList DiagramType.scc(Map<Component, Set<Component>> succ) {
		SCCList list = new SCCList();
		
		index = 0;
		Stack<Component> stack = new Stack<>();
		Map<Component, SCCData> map = new HashMap<>();
		for (Component c: components()) {
			if (!map.containsKey(c)) {
				strongConnect(c, stack, map, list, succ);
			}
		}
		
		return list;
	}
	
	private int DiagramType.index;
	protected void DiagramType.strongConnect(
				Component v, 
				Stack<Component> stack, 
				Map<Component, SCCData> map, 
				SCCList list,
				Map<Component, Set<Component>> succ) {
		map.put(v, new SCCData(index, index, true));
		index++;
		stack.push(v);

		for (Component w: succ.get(v)) {
			if (!map.containsKey(w)) {
				strongConnect(w, stack, map, list, succ);
				map.get(v).lowlink = Math.min(map.get(v).lowlink, map.get(w).lowlink);
			} else if (map.get(w).inStack) {
				map.get(v).lowlink = Math.min(map.get(v).lowlink, map.get(w).index);
			}
		}
		
		if (map.get(v).lowlink == map.get(v).index) {
			SCC scc = new SCC();
			Component w;
			do {
				w = stack.pop();
				map.get(w).inStack = false;
				scc.add(w);
			} while (w != v);
			list.add(scc);
		}
	}
	
	public class SCCData {
		public int index;
		public int lowlink;
		public boolean inStack;
		public SCCData(int index, int lowlink, boolean inStack) {
			this.index = index;
			this.lowlink = lowlink;
			this.inStack = inStack;
		}
	}
	
	public PredSuccData DiagramType.breakCycles() {
		PredSuccData data = new PredSuccData();
		data.pred = new HashMap<>();
		data.succ = new HashMap<>();
		for (Component c: components()) {
			data.pred.put(c, new HashSet<>(c.pred()));
			data.succ.put(c, new HashSet<>(c.succ()));
		}
		data.parent = new HashMap<>();
		
		SCCList sccs = scc(data.succ);
		while (hasCycles(sccs)) {
			for (SCC scc: sccs) {
				if (scc.size() > 1) {
					breakCycle(scc, data);
				}
			}
			sccs = scc(data.succ);
		}
		
		for (Map.Entry<Component, Set<Component>> e: data.succ.entrySet()) {
			Component c = e.getKey();
			if (e.getValue().contains(c)) {
				e.getValue().remove(c);
				data.pred.get(c).remove(c);
			}
		}
		
		return data;
	}
	public class PredSuccData {
		Map<Component, Set<Component>> pred;
		Map<Component, Set<Component>> succ;
		Map<Component, Component> parent;
	}
	protected void DiagramType.breakCycle(
			SCC scc, 
			PredSuccData data) {
	
		Component smallest = scc.first();
		
		Iterator<Component> itr = data.pred.get(smallest).iterator();
		while(itr.hasNext()) {
			Component p = itr.next();
			if (scc.contains(p) && p.index() > smallest.index()) {
				data.succ.get(p).remove(smallest);
				itr.remove();
			}
		}
		
		for (Component c: scc) {
			if (smallest != c) {
				data.parent.put(c, smallest);
			}
		}
	}
	protected boolean DiagramType.hasCycles(SCCList list) {
		for (SCC scc: list) {
			if (scc.size() > 1) {
				return true;
			}
		}
		return false;
	}
}