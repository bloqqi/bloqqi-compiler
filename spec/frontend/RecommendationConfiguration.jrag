import java.util.Set;
import java.util.SortedSet;
import java.util.SortedMap;
import java.util.TreeSet;
import java.util.TreeMap;

aspect RecommendationConfiguration {
	public FeatureConfiguration DiagramType.specialize() {
		return new FeatureConfiguration(this);
	}
	
	public FeatureConfiguration DiagramType.specialize(DiagramType subType) {
		FeatureConfiguration conf = new FeatureConfiguration(this);
		conf.match(subType);
		return conf;
	}
	
	public class FeatureConfiguration {
		private final DiagramType diagramType;
		private final SortedMap<String, OptionalFeature> optionals;
		private final SortedMap<String, MandatoryFeature> mandatories;

		public FeatureConfiguration(DiagramType diagramType) {
			SortedMap<String, OptionalFeature> optionalsTmp = new TreeMap<>();
			for (RecommendationGroup rg: diagramType.getRecommendationGroups()) {
				if (!rg.hasErrors()) {
					optionalsTmp.put(rg.name(), new OptionalFeature(rg));
				}
			}
			SortedMap<String, MandatoryFeature> mandatoriesTmp = new TreeMap<>();
			for (RecommendationReplaceable rr: diagramType.recommendedReplaceables()) {
				if (!rr.hasErrors()) {
					mandatoriesTmp.put(rr.name(), new MandatoryFeature(rr));
				}
			}
			this.diagramType = diagramType;
			this.optionals = Collections.unmodifiableSortedMap(optionalsTmp);
			this.mandatories = Collections.unmodifiableSortedMap(mandatoriesTmp);
		}

		public SortedSet<OptionalFeature> getOptionalFeatures() {
			return Collections.unmodifiableSortedSet(new TreeSet(optionals.values()));
		}
		
		public SortedSet<MandatoryFeature> getMandatoryFeatures() {
			return Collections.unmodifiableSortedSet(new TreeSet(mandatories.values()));
		}
		
		public Block newAnonymousBlock(String blockName) {
			Block block = new Block();
			block.setModifiers(new Modifiers());
			block.setName(new IdName(blockName));
			if (containsChanges()) {
				block.setType(new AnonymousType(newAnonymousDiagramType()));
			} else {
				block.setType(new TypeUse(diagramType.name()));
			}
			return block;
		}

		public DiagramType newDiagramType(String newName) {
			DiagramType newDt = new DiagramType();
			newDt.setID(newName);
			newDt.setModifiers(new Modifiers());
			newDt.addSuperType(new TypeUse(diagramType.name()));
			addBlocks(newDt);
			return newDt;
		}

		protected AnonymousDiagramType newAnonymousDiagramType() {
			AnonymousDiagramType newAdt = new AnonymousDiagramType();
			newAdt.setID("<anonymous>");
			newAdt.setModifiers(new Modifiers());
			newAdt.addSuperType(new TypeUse(diagramType.name()));
			addBlocks(newAdt);
			return newAdt;
		}
		
		private void addBlocks(DiagramType newDt) {
			for (OptionalFeature opt: computeSortedOptionals(optionals.values())) {
				if (opt.isSelected()) {
					newDt.addLocalBlock(opt.newBlock());
				}
			}
			for (MandatoryFeature m: mandatories.values()) {
				if (m.isRedeclared()) {
					newDt.addLocalBlock(m.newAnonymousRedeclare());
				}
			}
		}
		
		public boolean containsChanges() {
			for (OptionalFeature opt: optionals.values()) {
				if (opt.isSelected()) {
					return true;
				}
			}
			for (MandatoryFeature m: mandatories.values()) {
				if (m.isRedeclared()) {
					return true;
				}
			}
			return false;
		}

		private Collection<OptionalFeature> computeSortedOptionals(
				Collection<OptionalFeature> coll) {
			Map<RecommendationGroup, OptionalFeature> map = new HashMap<>();
			for (OptionalFeature opt: coll) {
				map.put(opt.getRecommendationGroup(), opt);
			}
			
			SuccessorFunction<OptionalFeature> succFunc;
			succFunc = new SuccessorFunction<OptionalFeature>() {
				public Collection<OptionalFeature> successors(OptionalFeature opt) {
					Set<OptionalFeature> set = new HashSet<>();
					for (RecommendationGroup rg: opt.getRecommendationGroup().groupsAfter()) {
						set.add(map.get(rg));
					}
					return set;
				}
			};
			
			Comparator<OptionalFeature> tieOrdering;
			tieOrdering = new Comparator<OptionalFeature>() {
				public int compare(OptionalFeature opt1, OptionalFeature opt2) {
					return opt1.getName().compareTo(opt2.getName());
				}
			};
			
			return Utils.topologicalSort(coll, succFunc, tieOrdering);
		}
		
		public void match(DiagramType dt) {
			for (Block b: dt.getLocalBlocks()) {
				if (b.type().isDiagramType()) {
					DiagramType bType = (DiagramType) b.type();

					String typeName;
					if (bType.isAnonymousType()) {
						typeName = bType.directSuperTypes().iterator().next().name();
					} else {
						typeName = bType.name();
					}
				
					OptionalFeature opt = optionals.get(b.name());
					if (opt != null && !b.isLocallyRedeclared()) {
						opt.match(bType, typeName);
					} else {
						MandatoryFeature m = mandatories.get(b.name());
						if (m != null && b.isLocallyRedeclared()) {
							m.match(bType, typeName);
						}
					}
				}
			}
		}
		
		public SortedSet<String> getNewInParameters() {
			return getNewInParameters("");
		}
		protected SortedSet<String> getNewInParameters(String path) {
			SortedSet<String> set = new TreeSet<>();
			String prefixPath = path.isEmpty() ? "" : path + ".";
			for (OptionalFeature opt: optionals.values()) {
				set.addAll(opt.getNewInParameters(prefixPath + opt.getName()));
			}
			for (MandatoryFeature m: mandatories.values()) {
				set.addAll(m.getNewInParameters(prefixPath + m.getName()));
			}
			return set;
		}
		
		public String getName() {
			return diagramType.name();
		}

		
		public boolean hasFeatures() {
			return !optionals.isEmpty() || !mandatories.isEmpty();
		}
	
		public String toString() {
			StringBuilder sb = new StringBuilder();
			sb.append(diagramType.name() + "\n");
			sb.append("  Combinations: " + nbrOfCombinations() + "\n");
			sb.append("  Optional features:\n");
			for (OptionalFeature opt: optionals.values()) {
				sb.append("  - " + opt.toString() + "\n");
			}
			sb.append("  Mandatory features:\n");
			for (MandatoryFeature m: mandatories.values()) {
				sb.append("  - " + m.toString() + "\n");
			}
			return sb.toString();
		}
	}
	
	public class OptionalFeature implements Comparable<OptionalFeature> {
		private final RecommendationGroup group;
		private final SortedMap<String, OptionalFeatureAlternative> alternatives;
		
		private boolean isSelected;
		private OptionalFeatureAlternative selectedAlternative;
		
		public OptionalFeature(RecommendationGroup group) {
			this.group = group;

			SortedMap<String, OptionalFeatureAlternative> tmpMap = new TreeMap<>();
			for (RecommendationBlock subRc: group.recommendedBlocks()) {
				for (DiagramType subType: subRc.blockType().namedConcreteSubTypes()) {
					boolean isDefault = subType == group.defaultType();
					OptionalFeatureAlternative alt = new OptionalFeatureAlternative(this, subRc, subType, isDefault);
					tmpMap.put(subType.name(), alt);
					if (isDefault) {
						selectedAlternative = alt;
					}
				}
			}
			alternatives = Collections.unmodifiableSortedMap(tmpMap);
			isSelected = false;
		}

		public RecommendationGroup getRecommendationGroup() {
			return group;
		}

		public String getName() {
			return group.name();
		}

		public SortedSet<OptionalFeatureAlternative> getAlternatives() {
			return Collections.unmodifiableSortedSet(new TreeSet(alternatives.values()));
		}
		public boolean isSelected() {
			return isSelected;
		}
		public DiagramType getDefaultType() {
			return group.defaultType();
		}
		public OptionalFeatureAlternative getSelectedAlternative() {
			return selectedAlternative;
		}
		
		public void setSelected(boolean isSelected) {
			this.isSelected = isSelected;
		}
		public void setSelectedAlternative(OptionalFeatureAlternative alt) {
			this.selectedAlternative = alt;
		}
		
		public void match(DiagramType dt, String typeName) {
			OptionalFeatureAlternative alt = alternatives.get(typeName);
			if (alt != null) {
				setSelectedAlternative(alt);
				if (dt.isAnonymousType()) {
					alt.specialize(dt);
				}
			}
			setSelected(true);
		}
		
		public SortedSet<String> getNewInParameters(String path) {
			if (isSelected()) {
				return getSelectedAlternative().getNewInParameters(path);
			} else {
				return Collections.emptySortedSet();
			}
		}
		
		public int compareTo(OptionalFeature other) {
			return getName().compareTo(other.getName());
		}

		protected Block newBlock() {
			return isSelected() ? getSelectedAlternative().newBlock() : null;
		}
	
		public String toString() {
			String selectedStr = isSelected() ? getSelectedAlternative().toString() : "N/A";
			return getName() + ": " + selectedStr + " selected of " + alternatives.values();
		}
	}
	
	public class OptionalFeatureAlternative implements Comparable<OptionalFeatureAlternative> {
		private final OptionalFeature optFeature;
		private final RecommendationBlock rb;
		private final DiagramType type;
		private final boolean isDefault;
		
		private FeatureConfiguration conf;
		
		public OptionalFeatureAlternative(OptionalFeature optFeature, RecommendationBlock rb,
				DiagramType type, boolean isDefault) {
			this.optFeature = optFeature;
			this.rb = rb;
			this.type = type;
			this.isDefault = isDefault;
		}
		
		public OptionalFeature getOptionalFeature() {
			return optFeature;
		}
		
		public DiagramType getType() {
			return type;
		}
		
		public String getName() {
			return type.name();
		}
		
		public boolean isDefault() {
			return isDefault;
		}
		
		public FeatureConfiguration specialize() {
			return specialize(null);
		}
		public FeatureConfiguration specialize(DiagramType dt) {
			if (conf == null) {
				if (dt != null) {
					conf = type.specialize(dt);
				} else {
					conf = type.specialize();
				}
			}
			return conf;
		}

		public boolean containsChanges() {
			return conf != null ? conf.containsChanges() : false;
		}
		
		public SortedSet<String> getNewInParameters(String path) {
			// Compute all input parameters that are -not- connected by the wiring
			Set<String> localParNames = new HashSet<>();
			for (InParameter in: type.getInParameters()) {
				localParNames.add(in.name());
			}
			if (rb.getBlock().hasWiring()) {
				for (InParameter in: rb.getBlock().wiring().connectedInParameters()) {
					localParNames.remove(in.name());
				}
			}

			SortedSet<String> newInPars = new TreeSet<>();
			// Add all local input parameters that are not connected by the wiring
			for (String inParName: localParNames) {
				newInPars.add(path + "." + inParName);
			}
			
			// Add parameters belonging to nested types
			if (containsChanges()) {
				newInPars.addAll(conf.getNewInParameters(path));
			}
			
			// Add parameters added in wiring, e.g, "inPar" in "block: Type[inPar: Int]",
			// but these parameters belong to the enclosing type.
			// Only add inner/nested parameters, and not parameters on the outermost level,
			// since parameters on the outermost level already are exposed as parameters.
			if (path.lastIndexOf(".") > 0) {
				for (InParameter in: rb.getBlock().inParameters()) {
					String parentPath = path.substring(0, path.lastIndexOf("."));
					String s = parentPath + "." + in.name();
					newInPars.add(s);
				}
			}
			
			return newInPars;
		}
		
		protected Type newType() {
			if (containsChanges()) {
				return new AnonymousType(conf.newAnonymousDiagramType());
			} else {
				return new TypeUse(type.name());
			}
		}
		
		protected Block newBlock() {
			if (rb.getBlock() instanceof WiredBlock) {
				WiredBlock wiredBlock = (WiredBlock) rb.getBlock();
				return new WiredBlock(
						wiredBlock.getModifiers().treeCopy(),
						newType(),
						wiredBlock.getName().treeCopy(),
						wiredBlock.getWiredBlockParameterList().treeCopy());
			} else {
				return new Block(
						rb.getBlock().getModifiers().treeCopy(),
						newType(),
						rb.getBlock().getName().treeCopy());
			}
		}
	
		public int compareTo(OptionalFeatureAlternative other) {
			return type.name().compareTo(other.type.name());
		}
		
		public String toString() {
			String isDefaultStr = isDefault ? " (default)" : "";
			return getName() + isDefaultStr;
		}
	}
	
	public class MandatoryFeature implements Comparable<MandatoryFeature> {
		private final RecommendationReplaceable replaceable; 
		private final SortedMap<String, MandatoryFeatureAlternative> alternatives;
		
		private final DiagramType defaultType;
		private MandatoryFeatureAlternative selectedAlternative;
		
		public MandatoryFeature(RecommendationReplaceable replaceable) {
			this.replaceable = replaceable;
			SortedMap<String, MandatoryFeatureAlternative> tmpMap = new TreeMap<>();
			for (DiagramType subType: replaceable.blockType().namedConcreteSubTypes()) {
				boolean isDefault = subType == replaceable.blockType();
				MandatoryFeatureAlternative alt = new MandatoryFeatureAlternative(this, subType, isDefault);
				if (isDefault) {
					selectedAlternative = alt;
				}
				tmpMap.put(subType.name(), alt);
			}
			defaultType = selectedAlternative.getType();
			alternatives = Collections.unmodifiableSortedMap(tmpMap);
		}
		
		public String getName() {
			return replaceable.name();
		}
		
		public boolean isRedeclared() {
			return !selectedAlternative.isDefault() || selectedAlternative.containsChanges();
		}
		
		public SortedSet<MandatoryFeatureAlternative> getAlternatives() {
			return Collections.unmodifiableSortedSet(new TreeSet(alternatives.values()));
		}
		
		public void setSelectedAlternative(MandatoryFeatureAlternative selectedAlternative) {
			this.selectedAlternative = selectedAlternative;
		}
		
		public MandatoryFeatureAlternative getSelectedAlternative() {
			return selectedAlternative;
		}
		
		public void match(DiagramType dt, String typeName) {
			MandatoryFeatureAlternative alt = alternatives.get(typeName);
			if (alt != null) {
				setSelectedAlternative(alt);
				if (dt.isAnonymousType()) {
					alt.specialize(dt);
				}
			}
		}
		
		public SortedSet<String> getNewInParameters(String path) {
			return selectedAlternative.getNewInParameters(path, defaultType);
		}
		
		protected Block newAnonymousRedeclare() {
			return new RedeclareBlock(
				new Modifiers(),
				selectedAlternative.newType(),
				new IdName(replaceable.name()));
		}

		public int compareTo(MandatoryFeature other) {
			return replaceable.name().compareTo(other.replaceable.name());
		}

		public String toString() {
			return replaceable.blockType().name();
		}
	}
	
	public class MandatoryFeatureAlternative implements Comparable<MandatoryFeatureAlternative> {
		private final MandatoryFeature mandatoryFeature;
		private final DiagramType type;
		private final boolean isDefault;
		
		private FeatureConfiguration conf;
		
		public MandatoryFeatureAlternative(MandatoryFeature mandatoryFeature,
				DiagramType type, boolean isDefault) {
			this.mandatoryFeature = mandatoryFeature;
			this.type = type;
			this.isDefault = isDefault;
			this.conf = null;
		}
		
		public MandatoryFeature getMandatoryFeature() {
			return mandatoryFeature;
		}
		
		public DiagramType getType() {
			return type;
		}
		
		public String getName() {
			return type.name();
		}
		
		public boolean isDefault() {
			return isDefault;
		}
		
		public FeatureConfiguration specialize() {
			return specialize(null);
		}
		public FeatureConfiguration specialize(DiagramType dt) {
			if (conf == null) {
				if (dt != null) {
					conf = type.specialize(dt);
				} else {
					conf = type.specialize();
				}
			}
			return conf;
		}
		
		public boolean containsChanges() {
			return conf != null ? conf.containsChanges() : false;
		}
		
		public SortedSet<String> getNewInParameters(String path, DiagramType defaultType) {
			SortedSet<String> set = new TreeSet<>();
			for (InParameter in: getType().addedInParameters(defaultType)) {
				set.add(path + "." + in.name());
			}
			if (containsChanges()) {
				set.addAll(conf.getNewInParameters(path));
			}
			return set;
		}
		
		protected Type newType() {
			if (containsChanges()) {
				return new AnonymousType(conf.newAnonymousDiagramType());
			} else {
				return new TypeUse(type.name());
			}
		}		
		
		public int compareTo(MandatoryFeatureAlternative other) {
			return type.name().compareTo(other.type.name());
		}
		
		public String toString() {
			String isDefaultStr = isDefault ? " (default)" : "";
			return getName() + isDefaultStr;
		}
	}
}

aspect RecursiveAnalysis {
	public boolean FeatureConfiguration.isRecursive() {
		return isRecursive(new HashSet<DiagramType>());
	}
	public boolean FeatureConfiguration.isRecursive(Set<DiagramType> visited) {
		if (visited.contains(diagramType)) {
			return true;
		}
		visited = new HashSet<>(visited);
		visited.add(diagramType);
		for (OptionalFeature opt: optionals.values()) {
			if (opt.isRecursive(visited)) {
				return true;
			}
		}
		for (MandatoryFeature m: mandatories.values()) {
			if (m.isRecursive(visited)) {
				return true;
			}
		}
		return false;
	}
	public boolean OptionalFeature.isRecursive(Set<DiagramType> visited) {
		for (OptionalFeatureAlternative alt: alternatives.values()) {
			if (alt.specialize().isRecursive(visited)) {
				return true;
			}
		}
		return false;
	}
	public boolean MandatoryFeature.isRecursive(Set<DiagramType> visited) {
		for (MandatoryFeatureAlternative alt: alternatives.values()) {
			if (alt.specialize().isRecursive(visited)) {
				return true;
			}
		}
		return false;
	}
}