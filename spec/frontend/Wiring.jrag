aspect Wiring {
	syn ArrayList<InParameter> Block.inParameters() 
		= new ArrayList<InParameter>(); 
	eq WiredBlock.inParameters() {
		ArrayList<InParameter> list = new ArrayList<>();
		for (WiredBlockParameter p: getWiredBlockParameters()) {
			if (p instanceof WiredBlockParameterInParameter) {
				list.add(((WiredBlockParameterInParameter) p).getInParameter());
			}
		}
		return list;
	}
	syn ArrayList<OutParameter> Block.outParameters() 
		= new ArrayList<>();
	eq WiredBlock.outParameters() {
		ArrayList<OutParameter> list = new ArrayList<>();
		for (WiredBlockParameter p: getWiredBlockParameters()) {
			if (p instanceof WiredBlockParameterOutParameter) {
				list.add(((WiredBlockParameterOutParameter) p).getOutParameter());
			}
		}
		return list;
	}
	
	syn nta List<FlowDecl> Block.flowDecls() = new List<>();
	eq WiredBlock.flowDecls() {
		List<FlowDecl> list = new List<>();
		if (type().hasWiring() && nbrOfParsMatch()) {
			for (FlowDecl fd: type().wiring().apply(this)) {
				list.add(fd);
			}
		}
		return list;
	}
	
	syn boolean TypeDecl.hasWiring() = false;
	eq DiagramType.hasWiring() = wiring() != null;
	syn boolean Block.hasWiring() = false;
	eq WiredBlock.hasWiring() = type().hasWiring();
	
	syn Wiring Block.wiring() = null;
	eq WiredBlock.wiring() = type().wiring();
	syn lazy Wiring TypeDecl.wiring() = null;
	eq DiagramType.wiring() {
		if (hasLocalWiring()) {
			return getLocalWiring();
		}
		ArrayList<DiagramType> list = new ArrayList<>();
		for (DiagramType dt: superTypesLinearizedReversed()) {
			if (dt != this && dt.hasLocalWiring()) {
				list.add(dt);
			}
		}
		if (!list.isEmpty()) {
			Iterator<DiagramType> itr = list.iterator();
			DiagramType mostSpecific = itr.next();
			while (itr.hasNext()) {
				DiagramType dt = itr.next();
				if (dt.isSubTypeOf(mostSpecific)) {
					mostSpecific = dt;
				} else if (!mostSpecific.isSubTypeOf(dt)) {
					// TODO Report ambiguous wiring
					return null;
				}
			}
			return mostSpecific.getLocalWiring();
		}
		
		return null;
	}

	syn boolean WiredBlock.nbrOfParsMatch() {
		if (type().hasWiring()) {
			return getNumWiredBlockParameter() == type().wiring().getNumWiringParameter();
		} else {
			return false;
		}
	}
	
	syn WiringParameter WiredBlockParameter.wiringParameter() {
		if (wiredBlock().nbrOfParsMatch()) {
			return wiredBlock().type().wiring().getWiringParameter(parameterIndex());
		} else {
			return null;
		}
	}
	
	inh WiredBlock WiredBlockParameter.wiredBlock();
	eq WiredBlock.getChild().wiredBlock() = this;
	
	inh int WiredBlockParameter.parameterIndex();
	eq WiredBlock.getWiredBlockParameter(int index).parameterIndex() = index;
	inh int WiringParameter.parameterIndex();
	eq Wiring.getWiringParameter(int index).parameterIndex() = index;
	
	eq WiringParameter.node() = this;
	
	syn Set<InheritedInParameter> Wiring.connectedInParameters() {
		Set<InheritedInParameter> set = new HashSet<>();
		for (FlowDecl fd: getFlowDecls()) {
			for (Anchor anchor: fd.connectedAnchors()) {
				if (anchor.node().isBlock() && anchor.isInParameter()) {
					Port port = (Port) anchor;
					set.add((InheritedInParameter) port.getParameter());
				}
			}
		}
		return set;
	}
}

aspect NameAnalysis {
	syn nta Block Wiring.block()
		= new Block(new Modifiers(), new TypeUse(diagramType().name()), new IdName(getTypeUse().getID()));
	
	eq WiringParameter.name() = getID();
	eq Wiring.getChild().lookup(String name) {
		for (WiringParameter p: getWiringParameters()) {
			if (p.name().equals(name)) {
				return p;
			}
		}
		if (block().name().equals(name)) {
			return block();
		}
		return null;
	}
	eq WiringParameter.type() = getTypeUse().type();
	eq WiringParameter.findMember(String name) = type().lookupField(name);
	eq WiringParameter.declaredParameter() = null;
}

aspect TypeAnalysis {
	syn TypeDecl WiredBlockParameter.type();
	eq WiredBlockParameterVarUse.type() = getVarUse().type();
	eq WiredBlockParameterInParameter.type() = getInParameter().type();
	eq WiredBlockParameterOutParameter.type() = getOutParameter().type();
	
	WiringParameter implements Anchor;
	eq WiringInParameter.isSource() = true;
	eq WiringInParameter.isTarget() = false;
	eq WiringInParameter.isInParameter() = true;
	eq WiringInParameter.isOutParameter() = false;
	eq WiringOutParameter.isSource() = false;
	eq WiringOutParameter.isTarget() = true;
	eq WiringOutParameter.isInParameter() = false;
	eq WiringOutParameter.isOutParameter() = true;
	
	inh TypeDecl WiredBlockParameter.expectedType();
	eq WiredBlock.getWiredBlockParameter(int index).expectedType() {
		WiringParameter par = getWiredBlockParameter(index).wiringParameter();
		return par != null ? par.type() : program().unknownType();
	}
	
	syn boolean WiredBlockParameter.isSource();
	eq WiredBlockParameterVarUse.isSource() 
		= getVarUse().declAnchor() != null 
		? getVarUse().declAnchor().isSource()
		: false;
	eq WiredBlockParameterInParameter.isSource() = true;
	eq WiredBlockParameterOutParameter.isSource() = false;
	
	
	// Used for simplification form rewrite
	eq WiredBlockParameterVarUse.getVarUse().isSource()
		= wiringParameter() != null ? wiringParameter().isSource() : false;
	eq WiredBlockParameterVarUse.getVarUse().isTarget()
		= wiringParameter() != null ? !wiringParameter().isSource() : false;
}

aspect ApplyWiring {
	public Collection<FlowDecl> Wiring.apply(WiredBlock b) {
		ArrayList<FlowDecl> list = new ArrayList<>();
		for (FlowDecl fd: getFlowDecls()) {
			list.add((FlowDecl) fd.copyAndApply(b));
		}
		return list;
	}
	
	public ASTNode ASTNode.copyAndApply(WiredBlock b) {
		ASTNode res = (ASTNode)copy();
		for(int i = 0; i < getNumChild(); i++) {
			ASTNode node = getChild(i);
			if(node != null) node = node.copyAndApply(b);
			res.setChild(node, i);
		}
		return res;
	}
	public ASTNode SimpleVarUse.copyAndApply(WiredBlock b) {
		if (decl() != null) {
			return decl().getAppliedVarUse(b);
		} else {
			return new SimpleVarUse(b.name());
		}
	}

	public VarUse VarDecl.getAppliedVarUse(WiredBlock b) {
		return new SimpleVarUse(name());
	}
	public VarUse Block.getAppliedVarUse(WiredBlock b) {
		return new SimpleVarUse(b.name());
	}
	public VarUse WiringParameter.getAppliedVarUse(WiredBlock b) {
		return b.getWiredBlockParameter(parameterIndex()).getAppliedVarUse();
	}
	public abstract VarUse WiredBlockParameter.getAppliedVarUse();
	public VarUse WiredBlockParameterVarUse.getAppliedVarUse() {
		return getVarUse().treeCopy();
	}
	public VarUse WiredBlockParameterInParameter.getAppliedVarUse() {
		return new SimpleVarUse(getInParameter().name());
	}
	public VarUse WiredBlockParameterOutParameter.getAppliedVarUse() {
		return new SimpleVarUse(getOutParameter().name());
	}
}

aspect Errors {
	WiredBlock contributes error("The type " + type().name() + " has no applicable wiring")
		when type().isKnown() && !type().hasWiring()
		to CompilationUnit.errors();

	WiredBlock contributes error("The number of wiring parameters does not match")
		when type().hasWiring() && !nbrOfParsMatch()
		to CompilationUnit.errors();
		
	WiredBlockParameter contributes error("Incompatible types. Required: " + expectedType().name() + ", found: " + type().name())
		when !type().compatibleWith(expectedType())
		to CompilationUnit.errors();
		
	WiredBlockParameter contributes error("Expected a source port, '" + toString() + "' is a target port")
		when wiringParameter() != null
			&& wiringParameter().isSource() && !isSource()
		to CompilationUnit.errors();

	WiredBlockParameter contributes error("Expected a target port, '" + toString() + "' is a source port")
		when wiringParameter() != null
			&& !wiringParameter().isSource() && isSource()
		to CompilationUnit.errors();

	Wiring contributes error("Type in wiring ('" + getTypeUse().getID()
			+ "') does not correspond to diagram type name ('" + diagramType().name() + "')")
		when !getTypeUse().getID().equals(diagramType().name())
		to CompilationUnit.errors();
		
	WiredBlockParameterInParameter contributes
			error("Name '" + getInParameter().name() + "' is already declared")
		when diagramType().lookup(getInParameter().name()) != getInParameter()
			&& diagramType().lookup(getInParameter().name()) != null
		to CompilationUnit.errors();
		
	WiredBlockParameterOutParameter contributes
			error("Name '" + getOutParameter().name() + "' is already declared")
		when diagramType().lookup(getOutParameter().name()) != getOutParameter()
			&& diagramType().lookup(getOutParameter().name()) != null
		to CompilationUnit.errors();
}
