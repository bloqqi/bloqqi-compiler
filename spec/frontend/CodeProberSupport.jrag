aspect CodeProberSupport {
	syn boolean ASTNode.cpr_isInsideExternalFile() = isInsideExternalFile();
	eq Program.cpr_isInsideExternalFile() = false;
	inh boolean ASTNode.isInsideExternalFile();
	eq Program.getChild().isInsideExternalFile() = true;
	eq Program.getCompilationUnit(int index).isInsideExternalFile() = index < getNumCompilationUnit() - 1;

	syn boolean CompilationUnit.cpr_isTALRoot() = true;
	syn ASTNode Program.pastaVisibleNextAfterRoot() {
		int numCUs = getNumCompilationUnit();
		return numCUs == 0 ? null : getCompilationUnit(numCUs - 1);
	}
}
