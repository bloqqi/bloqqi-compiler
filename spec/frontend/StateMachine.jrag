aspect StateMachineNameAnalysis {
	eq StateMachine.getChild().lookupId(String id) {
		for (InParameter in: getInParameters()) {
			if (in.name().equals(id)) {
				return in;
			}
		}
		for (OutParameter out: getOutParameters()) {
			if (out.name().equals(id)) {
				return out;
			}
		}
		for (StateVariable v: getStateVariables()) {
			if (v.name().equals(id)) {
				return v;
			}
		}
		return null;
	}
	StateVariable implements FunctionVarDecl;
	eq StateVariable.fType() = type();


	syn State Transition.fromState() = lookupState(getFromID());
	syn State Transition.toState() = lookupState(getToID());
	inh State Transition.lookupState(String name);
	inh State State.lookupState(String name);
	eq StateMachine.getChild().lookupState(String name) {
		for (State s: getStates()) {
			if (s.getID().equals(name)) {
				return s;
			}
		}
		return null;
	}

	coll Set<Transition> State.transitions() [new HashSet<>()] root StateMachine;
	Transition contributes this
		when fromState() != null
		to State.transitions() for fromState();
}

aspect StateMachinePorts {
	protected List<Port> StateMachine.createInPortList() {
		return createPortList(getInParameters());
	}

	protected List<Port> StateMachine.createOutPortList() {
		return createPortList(getOutParameters());
	}
}

aspect StateMachineErrors {
	Transition contributes error("Transitions are required to have a boolean condition")
		when !getFExpr().fType().isBool()
		to CompilationUnit.errors();

	Transition contributes error("State " + getFromID() + " not declared")
		when fromState() == null
		to CompilationUnit.errors();
	Transition contributes error("State " + getToID() + " not declared")
		when toState() == null
		to CompilationUnit.errors();

	State contributes error("State " + getID() + " already declared")
		when lookupState(getID()) != this
		to CompilationUnit.errors();

	IdFExpr contributes error("Cannot read an output parameter ('" + getID() + "')")
		when isInStateMachine() && decl() != null
			&& isVariableRead() && decl().isOutParameter()
		to CompilationUnit.errors();

	AssignStmt contributes error("Cannot assign a value to an input parameter ('"
			+ getLeft() + "')")
		when isInStateMachine() && getLeft().decl() != null
			&& getLeft().decl().isInParameter()
		to CompilationUnit.errors();

	State contributes error("Undefined output parameters in state " + getID()
			+ ": " + undefinedOutputs())
		when !undefinedOutputs().isEmpty()
		to CompilationUnit.errors();
}

aspect StateMachineErrorAnalysis {
	inh StateMachine State.stateMachine();
	eq StateMachine.getChild().stateMachine() = this;

	inh boolean IdFExpr.isVariableRead();
	eq Program.getChild().isVariableRead() = true;
	eq AssignStmt.getLeft().isVariableRead() = false;

	inh boolean IdFExpr.isInStateMachine();
	inh boolean AssignStmt.isInStateMachine();
	eq Program.getChild().isInStateMachine() = false;
	eq StateMachine.getChild().isInStateMachine() = true;

	syn Set<String> StateMachine.outputs() {
		Set<String> set = new HashSet<>();
		for (OutParameter p: getOutParameters()) {
			set.add(p.getID());
		}
		return set;
	}
	syn Set<String> State.undefinedOutputs() {
		Set<String> outputs = new HashSet<>(stateMachine().outputs());
		for (AssignStmt asg: getAssignStmts()) {
			outputs.remove(asg.getLeft().getID());
		}
		return outputs;
	}
}
