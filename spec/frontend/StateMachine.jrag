aspect StateMachineNameAnalysis {
	eq StateMachine.getChild().lookupId(String id) {
		for (InParameter in: getInParameters()) {
			if (in.name().equals(id)) {
				return in;
			}
		}
		for (OutParameter out: getOutParameters()) {
			if (out.name().equals(id)) {
				return out;
			}
		}
		for (StateVariable v: getStateVariables()) {
			if (v.name().equals(id)) {
				return v;
			}
		}
		return null;
	}
	StateVariable implements FunctionVarDecl;
	eq StateVariable.fType() = type();


	syn State Transition.fromState() = lookupState(getFromID());
	syn State Transition.toState() = lookupState(getToID());
	inh State Transition.lookupState(String name);
	inh State State.lookupState(String name);
	eq StateMachine.getChild().lookupState(String name) {
		for (State s: getStates()) {
			if (s.getID().equals(name)) {
				return s;
			}
		}
		return null;
	}
}

aspect StateMachinePorts {
	protected List<Port> StateMachine.createInPortList() {
		return createPortList(getInParameters());
	}

	protected List<Port> StateMachine.createOutPortList() {
		return createPortList(getOutParameters());
	}
}

aspect StateMachineErrors {
	Transition contributes error("Transitions are required to have a boolean condition")
		when !getFExpr().fType().isBool()
		to CompilationUnit.errors();

	Transition contributes error("State " + getFromID() + " not declared")
		when fromState() == null
		to CompilationUnit.errors();
	Transition contributes error("State " + getToID() + " not declared")
		when toState() == null
		to CompilationUnit.errors();

	State contributes error("State " + getID() + " already declared")
		when lookupState(getID()) != this
		to CompilationUnit.errors();
}
