aspect Features {
	eq Features.getFeatureStmt(int i).diagramType() {
		if (getTypeUse().type().isDiagramType()) {
			return (DiagramType) getTypeUse().type();
		}
		return program().unknownDiagramType();
	}

	coll Set<FeatureStmt> DiagramType.featureStmts()
		[new LinkedHashSet<FeatureStmt>()];
	FeatureStmt contributes this
		when !diagramType().isUnknownDiagramType()
		to DiagramType.featureStmts() for diagramType();
}

aspect NameAnalysisFeatures {
	syn FeatureDeclStmt FeatureIdUse.decl() = lookupFeature(getID());
	inh FeatureDeclStmt FeatureIdUse.lookupFeature(String name);
	eq Features.getFeatureStmt().lookupFeature(String name)
		= getTypeUse().type().lookupFeature(name);

	syn FeatureDeclStmt TypeDecl.lookupFeature(String name) = null;
	eq DiagramType.lookupFeature(String name) {
		for (FeatureStmt fs: featureStmts()) {
			FeatureDeclStmt f = fs.declares(name);
			if (f != null) {
				return f;
			}
		}
		return null;
	}
	syn FeatureDeclStmt FeatureStmt.declares(String name) = null;
	eq FeatureDeclStmt.declares(String name)
		= name.equals(getID()) ? this : null;


	inh FeatureDeclStmt FeatureDeclStmt.lookupFeature(String name);
	syn boolean FeatureDeclStmt.isAlreadyDeclared()
		= lookupFeature(getID()) != this;
}

aspect FeatureDecl {
	syn boolean FeatureDeclStmt.isOK()
		= getTypeUse().type().isSubTypeOf(diagramType())
			&& !afterTransitive().contains(this)
			&& !isAlreadyDeclared();
}

aspect BeforeFeaturesAnalysis {
	coll Set<FeatureDeclStmt> FeatureDeclStmt.before()
		[new LinkedHashSet<FeatureDeclStmt>()] root Program;
	FeatureBeforeStmt contributes getBefore().decl()
		when getBefore().decl() != null && getAfter().decl() != null
		to FeatureDeclStmt.before() for getAfter().decl();


	coll Set<FeatureDeclStmt> FeatureDeclStmt.after()
		[new LinkedHashSet<FeatureDeclStmt>()] root Program;
	FeatureBeforeStmt contributes getAfter().decl()
		when getBefore().decl() != null && getAfter().decl() != null
		to FeatureDeclStmt.after() for getBefore().decl();

	syn Set<FeatureDeclStmt> FeatureDeclStmt.afterTransitive()
			circular [new HashSet<FeatureDeclStmt>()] {
		Set<FeatureDeclStmt> set = new HashSet<>();
		set.addAll(after());
		for (FeatureDeclStmt f: after()) {
			set.addAll(f.afterTransitive());
		}
		return set;
	}
}

aspect Xor {
	syn Set<FeatureDeclStmt> FeatureDeclStmt.xorFeatures() {
		Set<FeatureDeclStmt> set = new HashSet<>();
		for (FeatureStmt f: diagramType().featureStmts()) {
			if (f instanceof FeatureXorStmt) {
				FeatureXorStmt xor = (FeatureXorStmt) f;
				FeatureDeclStmt first = xor.getFirst().decl();
				FeatureDeclStmt second = xor.getSecond().decl();
				if (first == this && second != null) {
					set.add(second);
				} else if (first != null && second == this) {
					set.add(first);
				}
			}
		}
		return set;
	}

	// Is xor transitive?
	syn Set<FeatureDeclStmt> FeatureDeclStmt.xorFeaturesTransitive()
			circular [new HashSet<FeatureDeclStmt>()] {
		Set<FeatureDeclStmt> set = new HashSet<>();
		set.addAll(xorFeatures());
		for (FeatureDeclStmt f: xorFeatures()) {
			set.addAll(f.xorFeaturesTransitive());
		}
		return set;
	}
}

aspect FeatureUse {
	eq DiagramType.getFeatureUse().lookupFeature(String name) = null;
	eq AnonymousDiagramType.getFeatureUse().lookupFeature(String name) {
		// Lookup features in first super type.
		// Don't use directSuperTypes() here since we will add
		// super types to that attribute (circular definition).
		for (TypeUse t: getSuperTypes()) {
			if (t.type().isDiagramType()) {
				return ((DiagramType) t.type()).lookupFeature(name);
			}
		}
		return null;
	}

	/** All features, ordered by lexical order */
	syn Set<FeatureDeclStmt> DiagramType.features() {
		Set<FeatureDeclStmt> set = new LinkedHashSet<>();
		for (FeatureUse use: getFeatureUses()) {
			if (use.getFeatureIdUse().decl() != null) {
				set.add(use.getFeatureIdUse().decl());
			}
		}
		return set;
	}

	syn Set<FeatureDeclStmt> FeatureUse.xorFeaturesUsed() {
		FeatureDeclStmt decl = getFeatureIdUse().decl();
		if (decl == null) {
			return Collections.emptySet();
		} else {
			Set<FeatureDeclStmt> set = new LinkedHashSet<>(decl.xorFeaturesTransitive());
			set.remove(decl);
			set.retainAll(diagramType().features());
			return set;
		}
	}

	syn Set<FeatureDeclStmt> FeatureUse.featuresIncorectlyBefore() {
		FeatureDeclStmt decl = getFeatureIdUse().decl();
		if (decl == null) {
			return Collections.emptySet();
		} else {
			Set<FeatureDeclStmt> set = new LinkedHashSet<>();
			for (FeatureDeclStmt f: diagramType().features()) {
				// Only look at features before this feature,
				// thus break if we get to this feature
				if (f == decl) {
					break;
				}
				if (decl.afterTransitive().contains(f)) {
					set.add(f);
				}
			}
			return set;
		}
	}

	syn boolean FeatureUse.isOK() =
		getFeatureIdUse().decl() != null &&
		getFeatureIdUse().decl().isOK() &&
		xorFeaturesUsed().isEmpty() &&
		featuresIncorectlyBefore().isEmpty();
}

aspect ErrorsFeatures {
	FeatureIdUse contributes
		error("Feature " + getID() + " not found")
		when decl() == null
		to CompilationUnit.errors();

	FeatureDeclStmt contributes
		error("Feature name " + getID() + " already declared")
		when !diagramType().isUnknownDiagramType() && isAlreadyDeclared()
		to CompilationUnit.errors();

	FeatureDeclStmt contributes
		error("Feature " + getID() + " is included in a circular before chain")
		when afterTransitive().contains(this)
		to CompilationUnit.errors();

	FeatureDeclStmt contributes
		error("The type " + getTypeUse() + " is not a subtype of " + diagramType().name())
		when !diagramType().isUnknownDiagramType()
			&& !getTypeUse().type().isSubTypeOf(diagramType())
		to CompilationUnit.errors();

	FeatureUse contributes
		error("Feature " + toString() + " cannot be used together with: "
			+ xorFeaturesUsed())
		when !xorFeaturesUsed().isEmpty()
		to CompilationUnit.errors();

	FeatureUse contributes
		error("Feature " + toString() + " should be before features: "+
			featuresIncorectlyBefore())
		when !featuresIncorectlyBefore().isEmpty()
		to CompilationUnit.errors();
}
