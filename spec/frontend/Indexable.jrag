aspect Indexable {
	public interface Indexable {
		int index();
	}
	Block implements Indexable;

	public class NameMap<V extends Indexable> extends HashMap<String, V> {
		public void add(KeyValue<String,V> p) {
			V old = get(p.key);
			if (old == null || old.index() > p.value.index())
				put(p.key, p.value);
		}
	}
	public class KeyValue<K,V> {
		public K key;
		public V value;
		public KeyValue(K key, V value) {
			this.key = key;
			this.value = value;
		}
	}
	
	inh lazy int Block.index();
	eq DiagramType.getLocalBlock(int index).index() = index;
	eq DiagramType.getBlock(int index).index() = index;
	eq Program.getChild().index() = -1;
}
