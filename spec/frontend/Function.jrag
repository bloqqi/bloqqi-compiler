aspect FunctionNameAnalysis {
	syn boolean TypeDecl.isFunction() = false;
	eq Function.isFunction() = true;

	public interface FunctionVarDecl {
		boolean isOutParameter();
		boolean isInParameter();
		boolean isStateVariable();
	}
	DeclStmt implements FunctionVarDecl;
	Parameter implements FunctionVarDecl;

	syn boolean DeclStmt.isOutParameter() = false;
	syn boolean DeclStmt.isInParameter() = false;
	syn boolean DeclStmt.isStateVariable() = false;
	syn boolean Parameter.isStateVariable() = false;

	syn FunctionVarDecl IdFExpr.decl() = lookupId(getID());

	inh FunctionVarDecl IdFExpr.lookupId(String id);
	inh FunctionVarDecl DeclStmt.lookupId(String id);
	inh FunctionVarDecl BlockStmt.lookupId(String id);

	eq Function.getBlockStmt().lookupId(String id) {
		for (InParameter ip : getInParameters()) {
			if (ip.name().equals(id)) {
				return ip;
			}
		}
		for (OutParameter op : getOutParameters()) {
			if (op.name().equals(id)) {
				return op;
			}
		}
		return null;
	}
	eq BlockStmt.getStmt(int index).lookupId(String id) {
		for (int i = 0; i < index; i++) {
			FunctionVarDecl d = getStmt(i).localLookupId(id);
			if (d != null) {
				return d;
			}
		}
		return lookupId(id);
	}
	syn FunctionVarDecl Stmt.localLookupId(String id) = null;
	eq DeclStmt.localLookupId(String id) {
		if (getID().equals(id)) {
			return this;
		}
		return null;
	}

	syn boolean DeclStmt.isMultipleDeclared() = lookupId(getID()) != null;

	// Use normal type lookup for function calls
	syn TypeDecl FunctionCallFExpr.decl() = lookupType(getID());
	inh TypeDecl FunctionCallFExpr.lookupType(String name);
}

aspect FunctionTypeAnalysis {
	syn TypeDecl FunctionVarDecl.fType();
	eq DeclStmt.fType() = getTypeUse().type();
	eq Parameter.fType() = getTypeUse().type();
	syn TypeDecl FExpr.fType();
	eq IdFExpr.fType() = decl() != null ? decl().fType() : program().unknownType();
	eq FunctionCallFExpr.fType() {
		if (!isBoundToFunction()) {
			return program().unknownType();
		}
		Function f = function();
		if (f.getNumOutParameter() != 1) {
			return program().unknownType();
		}
		return f.getOutParameter(0).type();
	}

	eq IntLiteralFExpr.fType() = program().intType();
	eq RealLiteralFExpr.fType() = program().realType();
	eq IntBinFExpr.fType() {
		if (getLeft().fType() == program().realType() ||
			getRight().fType() == program().realType()) {
			return program().realType();
		} else {
			return program().intType();
		}
	}

	syn boolean FunctionCallFExpr.isBoundToFunction()
		= decl() != null && decl().isFunction();
	syn Function FunctionCallFExpr.function() =
		isBoundToFunction() ? (Function) decl() : null;

	eq BoolLiteralFExpr.fType() = program().boolType();
	eq BoolBinFExpr.fType() = program().boolType();
	eq NotFExpr.fType() = program().boolType();
	eq MinusFExpr.fType() = getFExpr().fType();

	inh TypeDecl FExpr.fExpectedType();
	eq AddFExpr.getChild().fExpectedType() = program().realType();
	eq SubFExpr.getChild().fExpectedType() = program().realType();
	eq MulFExpr.getChild().fExpectedType() = program().realType();
	eq DivFExpr.getChild().fExpectedType() = program().realType();
	eq GEFExpr.getChild().fExpectedType() = program().realType();
	eq GTFExpr.getChild().fExpectedType() = program().realType();
	eq LEFExpr.getChild().fExpectedType() = program().realType();
	eq LTFExpr.getChild().fExpectedType() = program().realType();
	eq EqFExpr.getChild().fExpectedType() = getLeft().fType();
	eq NEqFExpr.getChild().fExpectedType() = getLeft().fType();
	eq AndFExpr.getChild().fExpectedType() = program().boolType();
	eq OrFExpr.getChild().fExpectedType() = program().boolType();
	eq MinusFExpr.getChild().fExpectedType() = program().realType();

	eq DeclStmt.getFExpr().fExpectedType() = fType();
	eq AssignStmt.getLeft().fExpectedType() = program().unknownType();
	eq AssignStmt.getRight().fExpectedType() = getLeft().fType();
	eq IfStmt.getFExpr().fExpectedType() = program().boolType();
	eq WhileStmt.getFExpr().fExpectedType() = program().boolType();

	eq FunctionCallFExpr.getFExpr(int i).fExpectedType() {
		if (!isBoundToFunction()) {
			return program().unknownType();
		}
		Function f = function();
		if (i < f.getNumOutParameter()) {
			return f.getOutParameter(i).type();
		} else {
			return program().unknownType();
		}
	}
}

aspect StatementAnalys {
	inh boolean ReturnStmt.isReturnInAllowedContext();
	eq Function.getBlockStmt().isReturnInAllowedContext() = false;
	eq IfStmt.getBlockStmt().isReturnInAllowedContext() = true;
	eq IfStmt.getElse().isReturnInAllowedContext() = true;
	eq WhileStmt.getBlockStmt().isReturnInAllowedContext() = true;

	inh boolean ReturnStmt.existStmtsAfterReturn();
	eq BlockStmt.getStmt(int index).existStmtsAfterReturn() = getNumStmt() > index+1;
}

aspect FunctionErrors {
	IdFExpr contributes error("The declaration of " + toString() + " was not found")
		when decl() == null
		to CompilationUnit.errors();

	DeclStmt contributes error("Variable " + getID() + " is already declared")
		when isMultipleDeclared()
		to CompilationUnit.errors();

	FExpr contributes error("Type error. Expected type: "
			+ fExpectedType() + ", got type: " + fType())
		when !fType().compatibleWith(fExpectedType())
		to CompilationUnit.errors();

	ReturnStmt contributes error("Incorrect placement of return statement.")
		when !(isReturnInAllowedContext())
		to CompilationUnit.errors();

	ReturnStmt contributes error("Statements not allowed after return.")
		when existStmtsAfterReturn()
		to CompilationUnit.errors();

	FunctionCallFExpr contributes error("Mismatch between the number of arguments and parameters in the call to " + getID() )
		when isBoundToFunction()
			&& function().getNumInParameter() != getNumFExpr()
		to CompilationUnit.errors();

	FunctionCallFExpr contributes error("Only functions are allowed to be called (" + getID() + ")")
		when decl() != null && !decl().isFunction()
		to CompilationUnit.errors();

	FunctionCallFExpr contributes error("Cannot find function " + getID())
		when decl() == null
		to CompilationUnit.errors();

	FunctionCallFExpr contributes error("Only functions with exactly one output parameter can be called (" + getID() + ")")
		when isBoundToFunction() && function().getNumOutParameter() != 1
		to CompilationUnit.errors();
}
