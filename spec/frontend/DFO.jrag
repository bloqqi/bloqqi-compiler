import java.util.Iterator;

/** 
 * This module defines the execution order/dataflow order for blocks
 * and it is based on connections between blocks and the declaration order 
 * of the blocks. This module assumes a acyclic dataflow graph, and cyclic
 * dataflow graphs are converted into acyclic dataflow graphs in the module Cycles.jrag. 
 * This module defines the execution order in terms of all inherited blocks, 
 * and not only locally defined blocks.
 */

aspect DFO {
	syn int Block.dfo() = declDfo();

	syn nta Block DiagramType.startBlock() 
		= new Block(new Modifiers(), new TypeUse(""), new IdName("<root>"));

	inh lazy Set<Block> Block.predP();
	eq DiagramType.getBlock(int i).predP() {
		if (hasDataflowCycles()) {
			return Collections.emptySet();
		}
		Block b = getBlock(i);
		if (b.predBlocks().isEmpty()) {
			Set<Block> set = new HashSet<Block>();
			set.add(startBlock());
			return set;
		} else {
			return b.predBlocks();
		}
	}
	eq DiagramType.startBlock().predP() = new HashSet<Block>();
	eq DiagramType.getLocalBlock().predP() = new HashSet<Block>();
	eq Program.getChild().predP() = new HashSet<Block>();
	inh Set<Block> Block.succP();
	eq DiagramType.getBlock(int i).succP() {
		if (hasDataflowCycles()) {
			return Collections.emptySet();
		} else {
			return getBlock(i).succBlocks();
		}
	}
	eq DiagramType.startBlock().succP() = roots();
	eq Program.getChild().succP() = new HashSet<Block>();

	syn boolean Expr.isBlock() = false;
	eq VarUse.isBlock() = node() instanceof Block;
	
	inh Set<Block> Block.roots();
	eq DiagramType.getBlock().roots() = roots();
	eq DiagramType.getLocalBlock().roots() = null;
	eq Program.getChild().roots() = null;
	syn lazy Set<Block> DiagramType.roots() {
		Set<Block> set = new HashSet<Block>();
		for (Block b: getBlocks()) {
			if (b.predBlocks().isEmpty()) {
				set.add(b);
			}
		}
		return set;
	}
	
	syn lazy Block Block.sinkPred() {
		Block sinkPred = null;
		for (Block p: predP()) {
			if (sinkPred == null || sinkPred.compare(p))
				sinkPred = p;
		}
		return sinkPred;
	}

	syn lazy boolean Block.compare(Block b2) {
		if (sinkPred() == b2.sinkPred()) 
			return index() < b2.index();
		else if (this == b2.sinkPred()) 
			return true;
		else if (sinkPred() == b2)
			return false;
		else if (depth() == b2.depth()) 
			return sinkPred().compare(b2.sinkPred());
		else if (depth() < b2.depth()) 
			return compare(b2.sinkPred());
		else 
			return sinkPred().compare(b2);
	}

	
	syn lazy int Block.depth() 
		= sinkPred() == null ? 0 : sinkPred().depth() + 1;
	

	Block implements Comparable<Block>;
	public int Block.compareTo(Block other) {
		return index() - other.index();
	}

	/*coll TreeSet<Block> Block.children() [new TreeSet<Block>()] with add root DiagramType;
	Block contributes this
		when sinkPred() != null
		to Block.children() for sinkPred();
	*/
	
	inh TreeSet<Block> Block.children();
	eq DiagramType.getBlock(int i).children() {
		Block parent = getBlock(i);
		TreeSet<Block> set = new TreeSet<>();
		for (Block b: getBlocks()) {
			if (parent == b.sinkPred()) {
				set.add(b);
			}
		}
		return set;
	}
	eq DiagramType.startBlock().children() {
		Block parent = startBlock();
		TreeSet<Block> set = new TreeSet<>();
		for (Block b: getBlocks()) {
			if (parent == b.sinkPred()) {
				set.add(b);
			}
		}
		return set;
	}
	eq Program.getChild().children() = new TreeSet<>();
	
	
	syn lazy TreeSet<Block> Block.sinkSiblings() {
		if (sinkPred() == null) 
			return new TreeSet<>();
		else 
			return sinkPred().children();
	}
	syn lazy int Block.maxDfo() {
		if (children().isEmpty()) 
			return declDfo();
		else 
			return children().last().maxDfo();
	}
	syn lazy int Block.declDfo() {
		if (diagramType().hasDataflowCycles()) {
			return -1;
		}
		if (predP().isEmpty()) 
			return 0;
		int max = 0;
		Block siblingBefore = sinkSiblings().lower(this);
		if (siblingBefore != null) 
			max = siblingBefore.maxDfo();
		else 
			max = sinkPred().declDfo();
		return max + 1;
	}
}
