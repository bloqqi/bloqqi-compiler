import java.util.HashSet;
import java.util.Map;
import java.util.HashMap;
import java.util.Collection;
import java.util.StringJoiner;

/**
 * This module defines nodes and dataflow between nodes. A node is either a 
 * parameter, variable or block. A node corresponds to  a graphical block 
 * in the graphical editor. 
 */

aspect Node {
	public interface Node {
		String name();
		DiagramType diagramType();
		boolean isInParameter();
		boolean isOutParameter();
		boolean hasIncomingLiterals();
	}
	
	Parameter implements Node;
	WiringParameter implements Node;
	Variable implements Node;
	Block implements Node;
	Literal implements Node;
	
	syn boolean Node.isParameter();
	eq Parameter.isParameter() = true;
	eq WiringParameter.isParameter() = true;
	eq Variable.isParameter() = false;
	eq Block.isParameter() = false;
	eq Literal.isParameter() = false;
	

	syn boolean Block.isInParameter() = false;
	syn boolean Block.isOutParameter() = false;
	
	syn boolean Node.isBlock();
	eq Parameter.isBlock() = false;
	eq WiringParameter.isBlock() = false;
	eq Variable.isBlock() = false;
	eq Block.isBlock() = true;
	eq Literal.isBlock() = false;
	
	syn boolean Anchor.hasIncomingLiterals() {
		for (Connection c: ingoingConnections()) {
			if (c.getSource().isLiteral()) {
				return true;
			}
		}
		return false;
	}
	syn boolean Block.hasIncomingLiterals() {
		for (Port in: getInPorts()) {
			if (in.hasIncomingLiterals()) {
				return true;
			}
		}
		return false;
	}
}

aspect NodeFlow {
	inh Block Port.block();
	eq Block.getChild().block() = this;
	
	syn lazy Node Expr.node() = null;
	eq AbstractSimpleVarUse.node() 
		= decl() instanceof Node ? (Node) decl() : null; 
	eq DotVarUse.node() = getVarUse().node();
	
	syn Set<Node> FlowDecl.connectedNodes();
	eq Connection.connectedNodes() = Utils.asSet(getSource().node(), getTarget().node());
	eq Interception.connectedNodes()
		= Utils.asSet(getIntercepted().node(), getTarget().node(), getSource().node());

	// Collect incoming connections. 
	// Ignore connections that are connected to a parameter to this diagram type.
	coll Set<Node> Node.pred() [new HashSet<Node>()] root DiagramType;
	Connection contributes getSource().node()
		when getSource().node() != null
			&& getTarget().node() != null
		to Node.pred() for getTarget().node();
	// Include nta connections() in collection attribute
	DiagramType contributes nta connections() to Node.pred();

	// Collect incoming connections. 
	// Ignore connections that are connected to a parameter to this diagram type.
	coll Set<Node> Node.succ() [new HashSet<Node>()] root DiagramType;
	Connection contributes getTarget().node()
		when getSource().node() != null
			&& getTarget().node() != null
		to Node.succ() for getSource().node();
	// Include nta connections() in collection attribute
	DiagramType contributes nta connections() to Node.succ();
				
	syn Set<Block> Block.predBlocks() {
		Set<Block> set = new HashSet<>();
		for (Node n: pred()) {
			if (n.isBlock()) {
				set.add((Block) n);
			}
		}
		return set;
	}

	syn Set<Block> Block.succBlocks() {
		Set<Block> set = new HashSet<>();
		for (Node n: succ()) {
			if (n.isBlock()) {
				set.add((Block) n);
			}
		}
		return set;
	}
}

aspect Cycles {
	syn boolean DiagramType.hasDataflowCycles() {
		for (Block b: blocks()) {
			if (b.isDataflowCircular()) {
				return true;
			}
		}
		return false;
	}
	
	syn String DiagramType.blocksInDataflowCycle() {
		if (!hasDataflowCycles()) {
			return "";
		}
		
		StringJoiner joiner = new StringJoiner(", ");
		for (Block b: blocks()) {
			if (b.isDataflowCircular()) {
				joiner.add(b.name());
			}
		}
		return joiner.toString();
	}
	
	syn Set<Block> Block.reachableBlocks() circular[new TreeSet<>()] {
		Set<Block> set = new TreeSet<Block>();
		for (Block b: succBlocks()) {
			set.add(b);
			set.addAll(b.reachableBlocks());
		}
		return set;
	}
	
	syn boolean Block.isDataflowCircular()
		= reachableBlocks().contains(this);
	
	syn boolean Connection.isOnDataflowCycle()
		= getSource().isBlock() && ((Block) getSource().node()).isDataflowCircular()
			&& getTarget().isBlock() && ((Block) getTarget().node()).isDataflowCircular();
}
