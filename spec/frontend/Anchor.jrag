/**
 * This module defines anchors and dataflow between anchors.
 * A connection is between two anchors.
 *
 * The dataflow between anchors is used, for example, to
 * identify anchors that have more than one incoming connection.
 *
 * The dataflow is defined between all anchors, both inherited and local.
 */

aspect AnchorFlow {
	public interface Anchor {
		DiagramType diagramType();
		TypeDecl type();
	}
	Parameter implements Anchor;
	Port implements Anchor;
	Variable implements Anchor;
	Literal implements Anchor;

	syn Anchor Expr.anchor() = null;
	eq AbstractSimpleVarUse.anchor() = declAnchor();
	eq DotVarUse.anchor() = declAnchor() != null ? declAnchor() : getVarUse().anchor();
	eq Literal.anchor() = this;

	syn Anchor Expr.declAnchor() = null;
	eq AbstractSimpleVarUse.declAnchor() = decl() instanceof Anchor ? (Anchor) decl() : null;
	eq DotVarUse.declAnchor() = decl() instanceof Anchor ? (Anchor) decl() : null;
	eq Literal.declAnchor() = this;

	coll Set<Connection> Anchor.outgoingConnections() [new HashSet<Connection>()] root DiagramType;
	Connection contributes this
		when getSource().anchor() != null
			&& getTarget().anchor() != null
		to Anchor.outgoingConnections() for getSource().anchor();
	// Include nta connections() in collection attribute
	DiagramType contributes nta connections() to Anchor.outgoingConnections();

	coll Set<Connection> Anchor.ingoingConnections() [new HashSet<Connection>()] root DiagramType;
	Connection contributes this
		when getSource().anchor() != null
			&& getTarget().anchor() != null
		to Anchor.ingoingConnections() for getTarget().anchor();
	// Include nta connections() in collection attribute
	DiagramType contributes nta connections() to Anchor.ingoingConnections();

	syn boolean Anchor.isInParameter();
	eq Port.isInParameter() = getParameter().isInParameter();
	eq Parameter.isInParameter() = false;
	eq InParameter.isInParameter() = true;
	eq Variable.isInParameter() = false;
	eq Literal.isInParameter() = false;
	syn boolean Anchor.isOutParameter();
	eq Port.isOutParameter() = !isInParameter();
	eq Parameter.isOutParameter() = !isInParameter();
	eq InParameter.isOutParameter() = !isInParameter();
	eq Variable.isOutParameter() = false;
	eq Literal.isOutParameter() = false;
	syn boolean Expr.isInParameter() = anchor() != null && anchor().isInParameter();
	syn boolean Expr.isOutParameter() = anchor() != null && anchor().isOutParameter();


	inh int Port.index();
	eq Block.getInPort(int index).index() = index;
	eq Block.getOutPort(int index).index() = index;

	syn Node Anchor.node();
	eq Port.node() = block();
	eq Parameter.node() = this;
	eq Variable.node() = this;
	eq Literal.node() = this;

	syn Set<Anchor> FlowDecl.connectedAnchors();
	eq Connection.connectedAnchors() = Utils.asSet(getSource().anchor(), getTarget().anchor());
	eq Interception.connectedAnchors()
		= Utils.asSet(getIntercepted().anchor(), getTarget().anchor(), getSource().anchor());

	syn Set<Pair<Node, Anchor>> FlowDecl.connectedNodesAnchors();
	eq Connection.connectedNodesAnchors() {
		return Utils.asSet(
				new Pair<>(getSource().node(), getSource().anchor()),
				new Pair<>(getTarget().node(), getTarget().anchor()));
	}
	eq Interception.connectedNodesAnchors() {
		return Utils.asSet(
				new Pair<>(getIntercepted().node(), getIntercepted().anchor()),
				new Pair<>(getTarget().node(), getTarget().anchor()),
				new Pair<>(getSource().node(), getSource().anchor()));
	}
}

/**
 * A block has a type and the type defines the parameters
 * of the block. The graphical editor wants an object representing
 * each parameter of the block, which is called port.
 * A Port refer to the corresponding Parameter in the type.
 */
aspect Ports {
	syn lazy List<Port> Block.getInPortList()
		= type().createInPortList();

	syn lazy List<Port> Block.getOutPortList()
		= type().createOutPortList();

	protected List<Port> TypeDecl.createInPortList() {
		List<Port> list = new List<>();
		for (int i = 0; i < numInParameters(); i++) {
			list.add(new Port(inParameter(i)));
		}
		return list;
	}
	protected List<Port> TypeDecl.createOutPortList() {
		List<Port> list = new List<>();
		for (int i = 0; i < numOutParameters(); i++) {
			list.add(new Port(outParameter(i)));
		}
		return list;
	}

	// The input and output parameters of a type
	syn int TypeDecl.numInParameters() = 0;
	eq DiagramType.numInParameters() = getNumInParameter();
	eq ExternalFunction.numInParameters() = getNumInParameter();
	eq Function.numInParameters() = getNumInParameter();

	syn Parameter TypeDecl.inParameter(int i) = null;
	eq DiagramType.inParameter(int i) = getInParameter(i);
	eq ExternalFunction.inParameter(int i) = getInParameter(i);
	eq Function.inParameter(int i) = getInParameter(i);

	syn int TypeDecl.numOutParameters() = 0;
	eq DiagramType.numOutParameters() = getNumOutParameter();
	eq ExternalFunction.numOutParameters() = hasOutParameter() ? 1 : 0;
	eq Function.numOutParameters() = getNumOutParameter();

	syn Parameter TypeDecl.outParameter(int i) = null;
	eq DiagramType.outParameter(int i) = getOutParameter(i);
	eq ExternalFunction.outParameter(int i) = getOutParameter();
	eq Function.outParameter(int i) = getOutParameter(i);
}
