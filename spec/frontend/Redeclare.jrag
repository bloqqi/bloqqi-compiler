aspect Redeclare {
	syn boolean VarDecl.isRedeclare() = false;
	eq RedeclareBlock.isRedeclare() = true;
	
	syn VarDecl RedeclareBlock.redeclaredDecl() {
		for (DiagramType superDt: diagramType().superTypesLinearizedReversed()) {
			if (superDt != diagramType()) {
				VarDecl vd = superDt.localLookup(name());
				if (vd != null) return vd;
			}
		}
		return null;
	}
	syn Block Block.redeclaredBlock() = null;
	eq RedeclareBlock.redeclaredBlock()
		= redeclaredDecl() instanceof Block ? (Block) redeclaredDecl() : null;

	syn boolean Block.isLocallyRedeclared() = false;
	eq RedeclareBlock.isLocallyRedeclared() = true;
	eq InheritedBlock.isLocallyRedeclared() = !isInherited() && declaredBlock().isRedeclare();
	eq InlinedBlock.isLocallyRedeclared() = false;
}

/**
 * Maps block declarations to their most specific block
 * due to redeclare in a diagram type.
 *
 * For example,
 *   diagramtype A() {
 *     T t;
 *   }
 *   diagramtype B extends A {
 *     redeclare S t;
 *   }
 * In diagram type B, the most specific block for
 * both "T t" and "redeclare S t" is "redeclare S t".
 * Here, S is a subtype of T.
 */
aspect MostSpecificBlock {
	syn lazy Map<Block, Block> DiagramType.mostSpecificBlockMap() {
		Map<Block, Block> map = new HashMap<>();
		
		// Add blocks that are redeclared
		for (DiagramType dt: superTypesLinearizedReversed()) {
			for (Block b: dt.getLocalBlocks()) {
				if (b.isRedeclare() && !map.containsKey(b)) {
					RedeclareBlock mostSpecific = (RedeclareBlock) b;
					Block block = mostSpecific;
					while (block != null) {
						map.put(block, mostSpecific);
						block = block.redeclaredBlock();
					}
				}
			}
		}

		// Add blocks that are -not- redeclared
		for (DiagramType dt: superTypesLinearizedReversed()) {
			for (Block b: dt.getLocalBlocks()) {
				if (!map.containsKey(b)) {
					map.put(b, b);
				}
			}
		}
		
		return map;
	}
	syn Block DiagramType.mostSpecificBlock(Block block)
		= mostSpecificBlockMap().get(block);
	
	syn boolean DiagramType.isMostSpecificBlock(Block block)
		= mostSpecificBlock(block) == block;
	
	
	syn java.util.List<Block> DiagramType.declaredBlocksTransitive() {
		ArrayList<Block> list = new ArrayList<>();
		for (DiagramType superType: superTypesLinearized()) {
			for (Block block: superType.getLocalBlocks()) {
				if (isMostSpecificBlock(block)) {
					list.add(block);
				}
			}
		}
		return list;
	}
}

aspect Errors {
	RedeclareBlock contributes error("Cannot redeclare '" + name() + "', name not found")
		when redeclaredDecl() == null
		to CompilationUnit.errors();
	
	RedeclareBlock contributes error("Cannot redeclare '" + name() + "', not a block")
		when redeclaredDecl() != null && !(redeclaredDecl() instanceof Block)
		to CompilationUnit.errors();
	
	RedeclareBlock contributes error("Cannot redeclare '" + name() + "', '" + type().name()
			+ "' is not a subtype of '" + redeclaredBlock().type().name() + "'")
		when redeclaredBlock() != null && !type().isSubTypeOf(redeclaredBlock().type())
		to CompilationUnit.errors();
}