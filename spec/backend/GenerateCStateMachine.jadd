aspect StateMachinesGenStructs {
	protected final static String ASTNode.STATEMACHINE_UNINITIALIZED_STATE = "_UNINITIALIZED";
	protected final static String ASTNode.STATEMACHINE_CURRENT_STATE_NAME = "_currentState";
	protected final static String ASTNode.STATEMACHINE_CURRENT_STATE
		= ASTNode.STATE_VAR + "->" + ASTNode.STATEMACHINE_CURRENT_STATE_NAME;

	eq StateMachine.returnTypeC() = allOutParameters().size() > 0 ? nameC() + "_RES" : "void";

	/** Generate struct for return value */
	public void StateMachine.genStructs(StringBuilder sb) {
		if (allOutParameters().size() > 0) {
			sb.append("typedef struct {\n");
			for (OutParameter op: allOutParameters()) {
				sb.append("  " + op.type().nameC() + " " + op.nameC() + ";\n");
			}
			sb.append("} " + returnTypeC() + ";\n");
		}
	}

	/** Function declaration */
	public void StateMachine.genDecls(StringBuilder sb) {
		sb.append(functionSignature() + ";\n");
	}

	/** Function signature */
	public String StateMachine.functionSignature() {
		String inPars = "";
		for (InParameter in: getInParameters()) {
			inPars += in.type().nameC() + " " + in.nameC() + ", ";
		}
		inPars += stateStructName() + "* " + ASTNode.STATE_VAR;
		return returnTypeC() + " " + nameC() + "(" + inPars + ")";
	}


	/** Function definition */
	public void StateMachine.genFunctionDefinitionsC(StringBuilder sb) {
		sb.append(functionSignature() + " {\n");

		genTransitionPartC(sb);
		genActionPartC(sb);

		sb.append("}\n");
	}

	public void StateMachine.genTransitionPartC(StringBuilder sb) {
		sb.append("  switch(" + ASTNode.STATEMACHINE_CURRENT_STATE +") {\n");

		/** UNINITIALIZED -> start state (first state) */
		sb.append("  case " + nameC() + "_" + ASTNode.STATEMACHINE_UNINITIALIZED_STATE + ":\n");
		String startState = getStateList().getChild(0).getID();
		sb.append("    " + ASTNode.STATEMACHINE_CURRENT_STATE + " = " + nameC() + "_" + startState + ";\n");
		sb.append("    break;\n");

		for (State s: getStates()) {
			sb.append("  case " + nameC() + "_" + s.getID() + ":\n");
			boolean first = true;
			for (Transition t: s.transitions()) {
				sb.append("    ");
				sb.append(first ? "if" : "else if");
				sb.append(" (" + t.getFExpr().generateC() + ") ");
				sb.append(ASTNode.STATEMACHINE_CURRENT_STATE + " = " + nameC() + "_" + t.getToID() + ";\n");
				first = false;
			}
			sb.append("    break;\n");
		}

		sb.append("  }\n");
	}

	public void StateMachine.genActionPartC(StringBuilder sb) {
		if(allOutParameters().size() > 0) {
			sb.append("  " + returnTypeC() + " " + ASTNode.RESULT_VAR + " = {0};\n");
		}

		sb.append("  switch(" + ASTNode.STATEMACHINE_CURRENT_STATE + ") {\n");
		for (State s: getStates()) {
			sb.append("  case " + nameC() + "_" + s.getID() + ":\n");
			for (State s2: getStates()) {
				if (s2.getIsPublic()) {
					String value = s.getID().equals(s2.getID()) ? "true" : "false";
					sb.append("    " + ASTNode.RESULT_VAR + ".");
					sb.append(s2.outParameter().nameC() + " = " + value + ";\n");
				}
			}
			for (AssignStmt asg: s.getAssignStmts()) {
				sb.append("    ");
				asg.generateC(sb);
			}
			sb.append("    break;\n");
		}
		sb.append("  case " + nameC() + "_" + ASTNode.STATEMACHINE_UNINITIALIZED_STATE + ":\n");
		sb.append("    break;\n");
		sb.append("  }\n");

		if(allOutParameters().size() > 0) {
			sb.append("  " + "return" + " " + ASTNode.RESULT_VAR + ";\n");
		}
	}


	/** State variable */
	eq StateMachine.containsVariablesTransitive(Class<? extends Variable> clazz)
		= clazz == StateVariable.class || clazz == Variable.class;
	eq StateMachine.stateStructName() = nameC() + "_STATE";

	public void StateMachine.genVariableStructsC(Map<TypeDecl, String> structs) {
		StringBuilder sb = new StringBuilder();

		/** Generate enum for state */
		StringJoiner states = new StringJoiner(", ");
		states.add(nameC() + "_" + ASTNode.STATEMACHINE_UNINITIALIZED_STATE);
		for (State s: getStates()) {
			states.add(nameC() + "_" + s.getID());
		}
		sb.append("enum " + nameC() + "_ENUM {" + states.toString() + "};\n");

		/** Generate state struct */
		sb.append("typedef struct {\n");
		for (StateVariable v: getStateVariables()) {
			sb.append("  " + v.type().nameC() + " " + v.cNameDeclaration() + ";\n");
		}
		sb.append("  enum " + nameC() + "_ENUM " + ASTNode.STATEMACHINE_CURRENT_STATE_NAME + ";\n");
		sb.append("} " + stateStructName() + ";\n");

		structs.put(this, sb.toString());
	}
}
