import static org.bloqqi.compiler.DistributedCGenerator.DistConfig;
import static org.bloqqi.compiler.DistributedCGenerator.ConfInput;
import static org.bloqqi.compiler.DistributedCGenerator.ConfOutput;

aspect GenerateCDist {
	public class CodeTargetDist extends CodeGenerationTarget {
		private DistConfig conf;

		public CodeTargetDist(Program p, DistConfig conf) {
			super(p);
			this.conf = conf;
		}

		private DiagramType diagramType() {
			return conf.getDiagramType();
		}

		@Override
		public void generateCPre(StringBuilder sb) {
			sb.append(Utils.readResource("/c/CCodePreDist.c")).append("\n");

			sb.append("#define CLIENTID \"" + conf.getType() + "\"\n");

			sb.append("const char * const SIGNALS[] = {\n");
			java.util.List<ConfInput> inputs = conf.getInputs();
			for (int i = 0; i < inputs.size(); i++) {
				sb.append("  \"" + inputs.get(i).getSignal() + "\"");
				if (i < inputs.size()-1) {
					sb.append(", ");
				}
				sb.append("\n");
			}
			sb.append("};\n\n");
		}

		@Override
		public void genStructsC(StringBuilder sb) {
			p.genWrapperStructC(sb, diagramType(), "bloqqi");
		}

		@Override
		public void genDeclarationsC(StringBuilder sb) {
			sb.append("void bloqqi_main(bloqqi_VARS *vars);\n");
		}

		@Override
		public void generateCPost(StringBuilder sb) {
			p.genWrapperDefinitionC(sb, diagramType(), "bloqqi_main", "bloqqi");

			diagramType().genDistInputFunctions(sb, conf);
			diagramType().genDistHandleInput(sb, conf);
			diagramType().genDistPublishTunableParameters(sb, conf);

			sb.append(Utils.readResource("/c/CCodePostDist.c")).append("\n");

			diagramType().genDistMain(sb, conf);
		}

		@Override
		public boolean lastUpdatedFieldOnInputs() {
			return true;
		}
	}

	public void DiagramType.genDistHandleInput(StringBuilder sb, DistConfig conf) {
		/** Generate handle_input */
		sb.append("void handle_input(char *topic, int topicLen, MQTTAsync_message *message) {\n");
		sb.append("  uint64_t time = useconds();\n");
		sb.append("  // Make sure that the payload is null-terminated\n");
		sb.append("  int size = message->payloadlen > 100 ? 100 : message->payloadlen;\n");
		sb.append("  char buf[size+1];\n");
		sb.append("  strncpy(buf, message->payload, size);\n");
		sb.append("  buf[size] = 0;\n");

		for (ConfInput in: conf.getInputs()) {
			TypeDecl type = in.getVariable().type();

			String setFunction = "set_input_" + in.getInput().replace(".", "_");
			String varDecl = "";
			String format = "";
			String suffix = "";
			if (type.isInteger() || type.isBool()) {
				varDecl = "int n = 0";
				suffix = "int";
			} else if (type.isReal()) {
				varDecl = "double n = 0.0";
				suffix = "double";
			}

			sb.append("  if(strncmp(topic, \"" + in.getSignal() + "\", topicLen) == 0) {\n");
			sb.append("    " + varDecl +";\n");
			sb.append("    if (read_" + suffix + "(buf, &n)) {\n");
			sb.append("      " + setFunction + "(n, time);\n");
			sb.append("    }\n");
			sb.append("  }\n");
		}
		sb.append("}\n");
	}

	public void DiagramType.genDistPublishTunableParameters(StringBuilder sb, DistConfig conf) {
		/** Generate publish_tunable_parameters_on_connect */
		sb.append("void *publish_tunable_parameters_on_connect(void *arg) {\n");
		sb.append("  MQTTAsync client = *((MQTTAsync *) arg);\n");
		sb.append("  free(arg);\n");
		sb.append("  usleep(500000L);\n");
		sb.append("  uint64_t time = useconds();\n");
		sb.append("  " + inputStructName() + " input = get_input();\n");
		for (ConfInput in: conf.getInputs()) {
			if (in.isTunableParameter()) {
				TypeDecl type = in.getVariable().type();
				String signal = "\"" + in.getSignal() + "\"";
				String path = "input." + in.getInput();
				String suffix = distGetSendSuffix(type);
				String ttl = "time-1000000";
				// Don't publish tunable parameter if we get value from the topic when connecting
				sb.append("  if (" + path + "_last_updated_ < " + ttl + ") {\n");
				sb.append("    send_message_" + suffix);
				sb.append("(client, " + signal + ", " + path + ", true);\n");
				sb.append("  }\n");
			}
		}
		sb.append("  return NULL;\n");
		sb.append("}\n");
	}

	public void DiagramType.genDistInputFunctions(StringBuilder sb, DistConfig conf) {
		String inputType = inputStructName();
		String inputVar = "input_var";
		String mutex = "input_var_lock";

		sb.append(inputType + " " + inputVar + ";\n");
		sb.append("pthread_mutex_t " + mutex + " = PTHREAD_MUTEX_INITIALIZER;\n");

		// init_input
		sb.append("void init_input() {\n");
		sb.append("  pthread_mutex_lock(&" + mutex + ");\n");
		for (ConfInput in: conf.getInputs()) {
			if (in.getDefault() != null) {
				String path = inputVar + "." + in.getInput();
				sb.append("  " + path + " = " + in.getDefault() + ";\n");
			}
		}
		sb.append("  pthread_mutex_unlock(&" + mutex + ");\n");
		sb.append("}\n");

		// get_input
		sb.append(inputType + " get_input() {\n");
		sb.append("  pthread_mutex_lock(&" + mutex + ");\n");
		sb.append("  " + inputType + " ret = " + inputVar + ";\n");
		sb.append("  pthread_mutex_unlock(&" + mutex + ");\n");
		sb.append("  return ret;\n");
		sb.append("}\n");

		// set_input_X functions
		for (Map.Entry<String, Variable> e: allInputVariables().entrySet()) {
			String varName = e.getKey().replace(".", "_");
			String functionName = "set_input_" + varName;
			String type = e.getValue().type().nameC();
			sb.append("void " + functionName + "(" + type + " p, uint64_t time) {\n");
			sb.append("  pthread_mutex_lock(&" + mutex + ");\n");
			sb.append("  " + inputVar + "." + e.getKey() + " = p;\n");
			sb.append("  " + inputVar + "." + e.getKey() + "_last_updated_ = time;\n");
			sb.append("  pthread_mutex_unlock(&" + mutex + ");\n");
			sb.append("}\n");
		}

		sb.append("\n");
	}


	public void DiagramType.genDistMain(StringBuilder sb, DistConfig conf) {
		sb.append("void bloqqi_run_main(MQTTAsync client) {\n");
		sb.append("  const int T = 1000000/" + conf.getFrequency() + ";\n");
		sb.append("  bloqqi_VARS vars = {};\n");
		sb.append("  uint64_t extra = 0;\n");
		sb.append("  while(true) {\n");
		sb.append("    uint64_t start = useconds();\n");
		sb.append("    vars.input = get_input();\n");

		for (ConfInput in: conf.getInputs()) {
			if (in.getTtl() > 0) {
				String path = "vars.input." + in.getInput();
				String ttl = "start-" + (Math.round(in.getTtl()*1000000));
				sb.append("    if (" + path + "_last_updated_ < " + ttl + ") {\n");
				sb.append("      " + path + " = " + in.getDefault() + ";\n");
				sb.append("    }\n");
			}
		}

		sb.append("    bloqqi_main(&vars);\n");

		sb.append("    if (is_connected()) {\n");
		for (ConfOutput out: conf.getOutputs()) {
			TypeDecl type = out.getVariable().type();
			String signal = "\"" + out.getSignal() + "\"";
			String path = "vars.output." + out.getOutput();
			String suffix = distGetSendSuffix(type);
			sb.append("      send_message_" + suffix);
			sb.append("(client, " + signal + ", " + path + ", false);\n");
		}
		sb.append("    }\n");

		sb.append("    uint64_t end = useconds();\n");
		sb.append("    extra = my_sleep(start, end, extra, T);\n");
		sb.append("  }\n");
		sb.append("}\n");
	}

	public String DiagramType.distGetSendSuffix(TypeDecl type) {
		String suffix = "";
		if (type.isInteger() || type.isBool()) {
			suffix = "int";
		} else if (type.isReal()) {
			suffix = "double";
		}
		return suffix;
	}
}
