aspect FlatName {
	syn String Node.flatName();
	eq Block.flatName() {
		if (isNameAmbiguous()) {
			return declaredInDiagramType().name() + "$" + getName().flatName();
		} else {
			return name();
		}
	}
	eq Parameter.flatName() = name();
	eq WiringParameter.flatName() = name();
	eq Variable.flatName() = name();
	eq Literal.flatName() = toString();

	syn String Name.flatName();
	eq IdName.flatName() = name();
	
	syn String TypeDecl.flatName() = name();
}

aspect FlattenedPrettyPrint {
	public String CompilationUnit.flattenedPrettyPrint() {
		StringBuilder sb = new StringBuilder();
		for (Declaration d : getDeclarations()) {
			d.flattenedPrettyPrint(sb);
		}
		return sb.toString();
	}

	public void Declaration.flattenedPrettyPrint(StringBuilder sb) {}
	public void DiagramType.flattenedPrettyPrint(StringBuilder sb) {
		sb.append("diagramtype " + flatName() + "(");

		sb.append(inParameters().toString(", "));
		if (outParameters().getNumChild() > 0) {
			sb.append(" => ");
			sb.append(outParameters().toString(", "));
		}

		sb.append(") {\n");
		for (Variable v : variables()) {
			sb.append("  " + v.prettyPrint() + ";\n");
		}
		for (Block b: blocks()) {
			sb.append("  " + b.flattenedPrettyPrint() + ";\n");
		}
		for (Connection c: connections()) {
			sb.append("  " + c.flattenedPrettyPrint() + ";\n");
		}
		sb.append("}\n");
		
		// Generate code for anonymous subtypes
		for (Block b: getLocalBlocks()) {
			if (b.hasAnonymousDiagramType()) {
				b.anonymousDiagramType().flattenedPrettyPrint(sb);
			}
		}
	}
	public void Function.flattenedPrettyPrint(StringBuilder sb) {
		prettyPrint(sb);
	}

	public String Block.flattenedPrettyPrint() {
		String inline = getModifiers().isInline() ? "inline " : "";
		return inline + flatName() + ": " + type().flatName();
	}
	public String DynamicBlock.flattenedPrettyPrint() {
		return flatName() + ": " + type().flatName();
	}
	public String Connection.flattenedPrettyPrint() {
		return "connect(" + getSource().flattenedPrettyPrint()
			+ ", " + getTarget().flattenedPrettyPrint() + ")";
	}

	public abstract String Expr.flattenedPrettyPrint();
	public String Literal.flattenedPrettyPrint() {
		return prettyPrint();
	}
	public String AbstractSimpleVarUse.flattenedPrettyPrint() {
		if (node() != null) {
			return node().flatName();
		} else {
			return "<null>";
		}
	}
	public String DotVarUse.flattenedPrettyPrint() {
		return getVarUse().flattenedPrettyPrint() + "." + getID();
	}
}
