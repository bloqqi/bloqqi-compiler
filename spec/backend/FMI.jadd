/**
 * Generate C and XML for FMI that will be used together with fmusdk2.
 */
aspect FMI {
	public static String ASTNode.FMI_DEFAULT_SAMPLING_TIME = "1.0";

	class FMIData {
		int nbrOfReals = 0;
		int nbrOfInts = 0;
		int nbrOfBools = 0;
		int nbrOfStrings = 0;
	}

	/**
	 * Generate C
	 */
	class FMIDataC extends FMIData {
		// Variable references
		StringBuilder sbVr = new StringBuilder();
		// Set start values
		StringBuilder sbStart = new StringBuilder();
		// Get real
		StringBuilder sbGetReal = new StringBuilder();
		// Update input values
		StringBuilder sbUpdateIn = new StringBuilder();
		// Update output values
		StringBuilder sbUpdateOut = new StringBuilder();
	}

	public void Program.genCForFMI(StringBuilder sb) {
		FMIDataC fmi = new FMIDataC();
		mainDiagramType().genCForFMI(fmi, "");

		int vrSamplingPeriod = fmi.nbrOfReals;
		String nameSamplingPeriod = "sampling_period_";
		fmi.nbrOfReals++;

		sb.append("#define MODEL_IDENTIFIER bloqqi\n");
		sb.append("#define MODEL_GUID \"{23ce3bae-8a59-4b70-b9b5-ec8a74d67181}\"\n");

		sb.append("#define NUMBER_OF_REALS " + fmi.nbrOfReals + "\n");
		sb.append("#define NUMBER_OF_INTEGERS " + fmi.nbrOfInts + "\n");
		sb.append("#define NUMBER_OF_BOOLEANS " + fmi.nbrOfBools + "\n");
		sb.append("#define NUMBER_OF_STRINGS " + fmi.nbrOfStrings + "\n");
		sb.append("#define NUMBER_OF_STATES 0\n");
		sb.append("#define NUMBER_OF_EVENT_INDICATORS 0\n");
		sb.append("#include \"fmuTemplate.h\"\n");
		sb.append(fmi.sbVr.toString());
		sb.append("#define " + nameSamplingPeriod + " " + vrSamplingPeriod + "\n");
		sb.append("#define STATES { }\n\n");

		sb.append("Main_VARS vars;\n\n");

		sb.append("void setStartValues(ModelInstance *comp) {\n");
		sb.append(fmi.sbStart.toString());
		sb.append("  r(" + nameSamplingPeriod + ") = " + ASTNode.FMI_DEFAULT_SAMPLING_TIME + ";\n");
		sb.append("  vars = (Main_VARS) {0};\n");
		sb.append("}\n\n");

		sb.append("void register_time_event(ModelInstance *comp) {\n");
		sb.append("  comp->eventInfo.nextEventTimeDefined   = fmi2True;\n");
		sb.append("  comp->eventInfo.nextEventTime          = r(" + nameSamplingPeriod + ") + comp->time;\n");
		sb.append("}\n\n");
		sb.append("void calculateValues(ModelInstance *comp) {\n");
		sb.append("  if (comp->state == modelInitializationMode) {\n");
		sb.append("    register_time_event(comp);\n");
		sb.append("  }\n");
		sb.append("}\n\n");

		sb.append("fmi2Real getReal(ModelInstance* comp, fmi2ValueReference vr){\n");
		sb.append("  switch (vr) {\n");
		sb.append(fmi.sbGetReal.toString());
		sb.append("    default: return 0.0;\n");
		sb.append("  }\n");
		sb.append("}\n\n");

		sb.append("void eventUpdate(ModelInstance *comp, fmi2EventInfo *eventInfo, int timeEvent) {\n");
		sb.append("  if (timeEvent) {\n");
		sb.append(fmi.sbUpdateIn.toString());
		sb.append("    bloqqi_main(&vars);\n");
		sb.append(fmi.sbUpdateOut.toString());
		sb.append("    register_time_event(comp);\n");
		sb.append("  }\n");
		sb.append("}\n\n");

		sb.append("#include \"fmuTemplate.c\"\n");
	}

	public void TypeDecl.genCForFMI(FMIDataC fmi, String enclosingPath) {
	}
	public void DiagramType.genCForFMI(FMIDataC fmi, String enclosingPath) {
		for (Variable v: variables()) {
			if (v.isInputVariable() || v.isOutputVariable()) {
				v.genCForFMI(fmi, enclosingPath);
			}
		}
		for (Block b: blocks()) {
			if (b.type().containsInputVariablesTransitive()
					|| b.type().containsOutputVariablesTransitive()) {
				String enc = enclosingPath + b.nameC() + ".";
				b.type().genCForFMI(fmi, enc);
			}
		}
	}
	public void Variable.genCForFMI(FMIDataC fmi, String enclosingPath) {
		String type = "";
		int vrIndex = 0;
		String startValue = "";
		
		if (type().isInteger()) {
			vrIndex = fmi.nbrOfInts;
			fmi.nbrOfInts++;
			type = "i";
			startValue = "0";
		} else if (type().isReal()) {
			vrIndex = fmi.nbrOfReals;
			fmi.nbrOfReals++;
			type = "r";
			startValue = "0.0";
		} else if (type().isBool()) {
			vrIndex = fmi.nbrOfBools;
			fmi.nbrOfBools++;
			type = "b";
			startValue = "fmi2False";
		}

		String varName = enclosingPath + name();
		String cName = varName.replace(".", "_") + "_";
		
		fmi.sbVr.append("#define " + cName + " " + vrIndex + "\n");
		fmi.sbStart.append(String.format("  %s(%s) = %s;\n",
			type, cName, startValue));

		if (isInputVariable()) {
			fmi.sbUpdateIn.append(String.format(
				"    vars.input.%s = %s(%s);\n",
				varName, type, cName));
		} else {
			fmi.sbUpdateOut.append(String.format(
				"    %s(%s) = vars.output.%s;\n",
				type, cName, varName));
			fmi.sbGetReal.append(String.format(
				"    case %s: return r(%s);\n",
				cName, cName));
		}
	}


	/**
	 * Generate XML
	 */
	class FMIDataXML extends FMIData {
		int totalVarIndex = 0;

		// Model variables
		StringBuilder sbMv = new StringBuilder();
		// Model structure
		StringBuilder sbMs = new StringBuilder();
	}

	public void Program.genXMLForFMI(StringBuilder sb) {
		FMIDataXML fmi = new FMIDataXML();
		mainDiagramType().genXMLForFMI(fmi, "");

		int vrSamplingPeriod = fmi.nbrOfReals;
		fmi.nbrOfReals++;

		sb.append("<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>\n");
		sb.append("<fmiModelDescription fmiVersion=\"2.0\"");
		sb.append(" modelName=\"bloqqi\"");
		sb.append(" guid=\"{23ce3bae-8a59-4b70-b9b5-ec8a74d67181}\"");
		sb.append(" numberOfEventIndicators=\"0\">\n");

		sb.append("<CoSimulation ");
		sb.append(" modelIdentifier=\"bloqqi\"");
		sb.append(" canHandleVariableCommunicationStepSize=\"true\"/>\n");

		sb.append("<LogCategories>\n");
		sb.append("  <Category name=\"logAll\"/>\n");
		sb.append("  <Category name=\"logError\"/>\n");
		sb.append("  <Category name=\"logFmiCall\"/>\n");
		sb.append("  <Category name=\"logEvent\"/>\n");
		sb.append("</LogCategories>\n");

		sb.append("<ModelVariables>\n");
		sb.append(fmi.sbMv.toString());
		sb.append("  <ScalarVariable name=\"sampling-period\" valueReference=\"" + vrSamplingPeriod + "\"");
		sb.append(" causality=\"parameter\" variability=\"fixed\" initial=\"exact\">\n");
		sb.append("    <Real start=\"1.0\"/>\n");
		sb.append("  </ScalarVariable>\n");
		sb.append("</ModelVariables>\n");

		sb.append("<ModelStructure>\n");
		sb.append("  <Outputs>\n");
		sb.append(fmi.sbMs.toString());
		sb.append("  </Outputs>\n");
		sb.append("</ModelStructure>\n");

		sb.append("</fmiModelDescription>");
	}

	public void TypeDecl.genXMLForFMI(FMIDataXML fmi, String enclosingPath) {
	}
	public void DiagramType.genXMLForFMI(FMIDataXML fmi, String enclosingPath) {
		for (Variable v: variables()) {
			if (v.isInputVariable() || v.isOutputVariable()) {
				v.genXMLForFMI(fmi, enclosingPath);
			}
		}
		for (Block b: blocks()) {
			if (b.type().containsInputVariablesTransitive()
					|| b.type().containsOutputVariablesTransitive()) {
				String enc = enclosingPath + b.nameC() + "_";
				b.type().genXMLForFMI(fmi, enc);
			}
		}
	}
	public void Variable.genXMLForFMI(FMIDataXML fmi, String enclosingPath) {
		int vrIndex = 0;
		String startValue = "";
		String type = "";

		if (type().isInteger()) {
			vrIndex = fmi.nbrOfInts;
			fmi.nbrOfInts++;
			startValue = "0";
			type = "Integer";
		} else if (type().isReal()) {
			vrIndex = fmi.nbrOfReals;
			fmi.nbrOfReals++;
			startValue = "0.0";
			type = "Real";
		} else if (type().isBool()) {
			vrIndex = fmi.nbrOfBools;
			fmi.nbrOfBools++;
			startValue = "false";
			type = "Boolean";
		}

		fmi.totalVarIndex++;

		String extra = "";
		String causality = "";
		if (isOutputVariable()) {
			extra = "initial=\"exact\"";
			causality = "output";
		} else {
			causality = "input";
		}

		String name = enclosingPath + name();
		fmi.sbMv.append(String.format(
			"  <ScalarVariable name=\"%s\" valueReference=\"%d\"" +
			" causality=\"%s\" variability=\"discrete\" %s>\n" +
			"    <%s start=\"%s\"/>\n" +
			"  </ScalarVariable>\n",
			name, vrIndex, causality, extra, type, startValue));

		if (isOutputVariable()) {
			fmi.sbMs.append(String.format(
				"    <Unknown index=\"%d\" />\n",
				fmi.totalVarIndex));
		}
	}
}