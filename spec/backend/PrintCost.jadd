aspect PrintCost {
	public String CompilationUnit.printCost() {
		StringBuilder sb = new StringBuilder();
		for (Declaration d : getDeclarations()) {
			d.printCost(0, sb);
		}
		return sb.toString();
	}

	public void Declaration.printCost(int indent, StringBuilder sb) {}
	public void DiagramType.printCost(int indent, StringBuilder sb) {
		int parameters = getNumInParameter() + getNumOutParameter();
		int blocks = getNumBlock();
		int connections = getNumConnection();
		int total = parameters + blocks + connections;
		sb.append(getIndent(indent) + name() + ":\n");
		sb.append(getIndent(indent) + "- parameters: " + parameters + "\n");
		sb.append(getIndent(indent) + "- blocks: " + blocks + "\n");
		sb.append(getIndent(indent) + "- connections: " + connections + "\n");
		sb.append(getIndent(indent) + "- total: " + total + "\n");
		
		for (Block b: getBlocks()) {
			if (b.hasAnonymousDiagramType()) {
				b.anonymousDiagramType().printCost(indent+1, sb);
			}
		}
	}


