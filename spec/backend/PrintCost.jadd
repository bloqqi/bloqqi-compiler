aspect PrintCost {
	public String CompilationUnit.printCost() {
		StringBuilder sb = new StringBuilder();
		for (Declaration d : getDeclarations()) {
			d.printCost(sb);
		}
		return sb.toString();
	}

	public void Declaration.printCost(StringBuilder sb) {}
	public void DiagramType.printCost(StringBuilder sb) {
		int parameters = getNumLocalInParameter() + getNumLocalOutParameter();
		sb.append(name() + ":\n");
		sb.append("- Local:\n");
		sb.append("  - parameters: " + parameters + "\n");
		sb.append("  - blocks: " + getNumLocalBlock() + "\n");
		int conn = 0;
		int intercept = 0;
		for (FlowDecl fd: getFlowDecls()) {
			if (fd instanceof Connection) conn++;
			if (fd instanceof Interception) intercept++;
		}
		sb.append("  - connections: " + conn + "\n");
		sb.append("  - intercept: " + intercept + "\n");
		sb.append("- Total:\n");
		sb.append("  - parameters: " + (getNumInParameter() + getNumOutParameter()) + "\n");
		sb.append("  - block: " + getNumBlock() + "\n");
		sb.append("  - connections: " + getNumConnection() + "\n");
		int codeCost = parameters + getNumLocalBlock() + conn + intercept;
		sb.append("- code cost: " + codeCost + "\n");
		
		int runtimeCost = 0;
		runtimeCost += getNumBlock();
		runtimeCost += getNumConnection();
		runtimeCost += getNumInParameter();
		runtimeCost += getNumOutParameter();
		sb.append("- runtime cost: " + runtimeCost + "\n");
	}
	
	public long FeatureConfiguration.nbrOfCombinations() {
		long combinations = 1;
		for (OptionalFeature opt: optionals.values()) {
			combinations *= opt.nbrOfCombinations();
		}
		for (MandatoryFeature m: mandatories.values()) {
			combinations *= m.nbrOfCombinations();
		}
		return combinations;
	}
	public long OptionalFeature.nbrOfCombinations() {
		long combinations = 1; // optional feature does not need to be selected
		for (OptionalFeatureAlternative alt: alternatives.values()) {
			// Use additions since only one alternative can be selected
			combinations += alt.nbrOfCombinations();
		}
		return combinations;
	}
	public long OptionalFeatureAlternative.nbrOfCombinations() {
		return specialize().nbrOfCombinations();
	}
	public long MandatoryFeature.nbrOfCombinations() {
		// mandatory feature need to be selected
		long combinations = 0;
		for (MandatoryFeatureAlternative alt: alternatives.values()) {
			// Use additions since only one alternative can be selected
			combinations += alt.nbrOfCombinations();
		}
		return combinations;
	}
	public long MandatoryFeatureAlternative.nbrOfCombinations() {
		return specialize().nbrOfCombinations();
	}
}
