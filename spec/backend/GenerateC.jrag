import java.util.Scanner;
import java.util.Set;
import java.io.*;


aspect CodeGenerationTarget {
	/**
	 * Constants representing different code generation targets.
	 * A class is used instead of enum, since it allows constants to be modularly added by JastAdd.
	 */
	public final class CodeGenerationTarget {
		private CodeGenerationTarget() {
			/** Instances are only allowed to be created within the class */
		}
	}
	public static CodeGenerationTarget CodeGenerationTarget.WITH_DRIVER = new CodeGenerationTarget();
	public static CodeGenerationTarget CodeGenerationTarget.WITHOUT_DRIVER = new CodeGenerationTarget();
	public static CodeGenerationTarget CodeGenerationTarget.MINIMAL = new CodeGenerationTarget();
	public static CodeGenerationTarget CodeGenerationTarget.TESTING = new CodeGenerationTarget();
	public static CodeGenerationTarget CodeGenerationTarget.FMI = new CodeGenerationTarget();

	public class CodeGenerationData {
		private final String name;
		private final String uuid;

		public CodeGenerationData() {
			this("Bloqqi");
		}

		public CodeGenerationData(String name) {
			this.name = name;
			this.uuid = java.util.UUID.randomUUID().toString();
		}

		public String getName() {
			return name;
		}

		public String getUUID() {
			return uuid;
		}
	}

}


aspect GenerateC {
	protected final static String ASTNode.STATE_VAR = "_state";
	protected final static String ASTNode.INPUT_VAR = "_input";
	protected final static String ASTNode.OUTPUT_VAR = "_output";

	protected final static String ASTNode.STATE_FIELD = "state";
	protected final static String ASTNode.INPUT_FIELD = "input";
	protected final static String ASTNode.OUTPUT_FIELD = "output";

	public final static String ASTNode.GENERATED_C_INFO = "/* FILE GENERATED BY THE BLOQQI COMPILER */";

	public String Program.generateC() {
		return generateC(CodeGenerationTarget.WITH_DRIVER, new CodeGenerationData());
	}

	public String Program.generateC(CodeGenerationTarget codeTarget) {
		return generateC(codeTarget, new CodeGenerationData());
	}

	public String Program.generateC(CodeGenerationData data) {
		return generateC(CodeGenerationTarget.WITH_DRIVER, data);
	}

	public String Program.generateC(CodeGenerationTarget codeTarget,
			CodeGenerationData data) {
		StringBuilder sb = new StringBuilder();
		generateCForOneFile(sb, codeTarget, data);
		return sb.toString();
	}
	
	public void Program.generateCForOneFile(StringBuilder sb,
			CodeGenerationTarget codeTarget,
			CodeGenerationData data) {
		sb.append(ASTNode.GENERATED_C_INFO + "\n");
		generateCPre(sb, codeTarget);
		generateCDeclarations(sb, codeTarget);
		generateCDefinitions(sb);
		generateCPost(sb, codeTarget, data);
	}

	public void Program.generateCSeparateFiles(String headerFilename,
			StringBuilder sbHeader, StringBuilder sbC,
			CodeGenerationTarget codeTarget,
			CodeGenerationData data) {
		// Header file
		String headerGuard = headerFilename.replace(".", "_");
		headerGuard = headerGuard.replace("-", "_");
		headerGuard = headerGuard.replace(" ", "_");
		headerGuard = "__" + headerGuard + "_GUARD";
		sbHeader.append(ASTNode.GENERATED_C_INFO + "\n");
		sbHeader.append("#ifndef " + headerGuard + "\n");
		sbHeader.append("#define " + headerGuard + "\n\n");
		generateCDeclarations(sbHeader, codeTarget);
		sbHeader.append("#endif\n");

		// C file
		sbC.append(ASTNode.GENERATED_C_INFO + "\n");
		sbC.append("#include \"" + headerFilename + "\"\n");
		generateCPre(sbC, codeTarget);
		generateCDefinitions(sbC);
		generateCPost(sbC, codeTarget, data);
	}

	public void Program.generateCPre(StringBuilder sb, CodeGenerationTarget codeTarget) {
		if (codeTarget == CodeGenerationTarget.WITH_DRIVER ||
				codeTarget == CodeGenerationTarget.WITHOUT_DRIVER ||
				codeTarget == CodeGenerationTarget.TESTING ||
				codeTarget == CodeGenerationTarget.FMI) {
			sb.append(Utils.readResource("/c/CCodePre.c")).append("\n");
		}
	}
	
	public void Program.generateCDeclarations(StringBuilder sb, CodeGenerationTarget codeTarget) {
		sb.append("/* Typedefs */\n");
		sb.append("#include <stdbool.h>\n");
		sb.append("typedef double Real;\n");
		sb.append("typedef int Int;\n");
		sb.append("typedef bool Bool;\n");
		sb.append("typedef const char* String;\n");
		sb.append("\n");

		sb.append("/* Structs representing variables (state, input, output) */\n");
		genVariableStructsC(sb);
		sb.append("\n");
		genMainWrapperStructC(sb);

		sb.append("/* Structs representing return values */\n");
		genStructs(sb);
		sb.append("\n");
		
		sb.append("/* Function declarations */\n");
		sb.append("void bloqqi_main(Main_VARS *vars);\n");
		if (codeTarget == CodeGenerationTarget.WITH_DRIVER ||
				codeTarget == CodeGenerationTarget.WITHOUT_DRIVER) {
			sb.append("char *bloqqi_to_json(Main_VARS *vars);\n");
			sb.append("void bloqqi_set_input_variable(Main_VARS *vars, const char *path, const char *value);\n");
		}
		genDecls(sb);
		sb.append("\n");
	}

	public void Program.generateCDefinitions(StringBuilder sb) {
		sb.append("/* Standard functions */\n");
		generateStdLibC(sb);
		sb.append("\n");

		sb.append("/* Function definitions */\n");
		for (CompilationUnit cu: getCompilationUnits()) {
			cu.genFunctionDefinitionsC(sb);
		}
		sb.append("\n");

		genMainWrapperDefinitionC(sb);
	}

	public void Program.generateCPost(StringBuilder sb,
			CodeGenerationTarget codeTarget,
			CodeGenerationData data) {
		if (codeTarget == CodeGenerationTarget.WITH_DRIVER) {
			sb.append(Utils.readResource("/c/CCodePost.c")).append("\n");
		} else if (codeTarget == CodeGenerationTarget.TESTING) {
			sb.append(Utils.readResource("/c/CCodePostTesting.c")).append("\n");
		} else if (codeTarget == CodeGenerationTarget.FMI) {
			genCForFMI(sb, data);
		}

		if (codeTarget == CodeGenerationTarget.WITH_DRIVER ||
				codeTarget == CodeGenerationTarget.WITHOUT_DRIVER) {
			genStateToJSON(sb);
			genSetInputVariable(sb);
		}
	}
	
	public void Program.generateStdLibC(StringBuilder sb) {
		for (Declaration decl : getStandardLibrary().getDeclarations()) {
			decl.generateStdLibC(sb);
		}
	}
	
	public void Declaration.generateStdLibC(StringBuilder sb) {
	}
	
	public void Function.generateStdLibC(StringBuilder sb) {
	    generateC(sb);
	}
}


/** 
 * Generate structs, including struct for return values
 */
aspect Structs {
	public void ASTNode.genStructs(StringBuilder sb) {
		for (ASTNode child: astChildren()) {
			child.genStructs(sb);
		}
	}
	public void DiagramType.genStructs(StringBuilder sb) {
		if (getNumOutParameter() > 0) {
			sb.append("typedef struct {\n");
			for (OutParameter op: getOutParameters()) {
				sb.append("  " + op.type().nameC() + " " + op.nameC() + ";\n");
			}
			sb.append("} " + returnTypeC() + ";\n");
		}
		for (Block b: blocks()) {
			if (b.hasAnonymousDiagramType()) {
				b.anonymousDiagramType().genStructs(sb);
			}
		}
	}
	public void Struct.genStructs(StringBuilder sb) {
		sb.append("typedef struct {\n");
		for (StructField f: getStructFields()) {
			sb.append("  " + f.type().nameC() + " " + f.nameC() + "\n");
		}
		sb.append("} " + nameC() + ";\n");
	}
}

/** 
 * Generate function declarations
 */
aspect FunctionDeclarations {
	public void ASTNode.genDecls(StringBuilder sb) {
		for(ASTNode child: astChildren()) {
			child.genDecls(sb);
		}
	}
	public void DiagramType.genDecls(StringBuilder sb) {
		sb.append(functionSignature() + ";\n");
		
		// Generate declarations for anonymous subtypes too
		for (Block b: blocks()) {
			if (b.hasAnonymousDiagramType()) {
				b.anonymousDiagramType().genDecls(sb);
			}
		}
	}
	public void ExternalFunction.genDecls(StringBuilder sb) {
		sb.append(functionSignature() + ";\n");
	}
	
	
	syn String TypeDecl.returnTypeC() = "<undefined>";
	eq DiagramType.returnTypeC() = getNumOutParameter() > 0 ? nameC() + "_RES" : "void";
	eq Function.returnTypeC() = getNumOutParameter() > 0 ? nameC() + "_RES" : "void";
	eq ExternalFunction.returnTypeC() {
		if (hasOutParameter()) {
			return getOutParameter().getTypeUse().type().nameC();
		} else {
			return "void";
		}
	}

	public String DiagramType.functionSignature() {
		String inPars = "";
		for (int i = 0; i < getNumInParameter(); i++) {
			InParameter in = getInParameter(i);
			inPars += in.type().nameC() + " " + in.nameC();
			if (i < getNumInParameter()-1) inPars += ", ";
		}
		if (containsStateVariablesTransitive()) {
			if (!inPars.isEmpty()) inPars += ", ";
			inPars += stateStructName() + "* " + ASTNode.STATE_VAR;
		}
		if (containsInputVariablesTransitive()) {
			if (!inPars.isEmpty()) inPars += ", ";
			inPars += inputStructName() + "* " + ASTNode.INPUT_VAR;
		}
		if (containsOutputVariablesTransitive()) {
			if (!inPars.isEmpty()) inPars += ", ";
			inPars += outputStructName() + "* " + ASTNode.OUTPUT_VAR;
		}
		return returnTypeC() + " " + nameC() + "(" + inPars + ")";
	}
	public String ExternalFunction.functionSignature() {
		String inPars = "";
		for (int i = 0; i < getNumInParameter(); i++) {
			InParameter in = getInParameter(i);
			inPars += in.type().nameC() + " " + in.nameC();
			if (i < getNumInParameter()-1) inPars += ", ";
		}
		return returnTypeC() + " " + nameC() + "(" + inPars + ")";
	}
}


/**
 * Generate function implementations 
 */
aspect FunctionDefinitions {
	public void Program.genMainWrapperDefinitionC(StringBuilder sb) {
		sb.append("void bloqqi_main(Main_VARS *vars) {\n");
		String pars = "";
		if (mainDiagramType().containsStateVariablesTransitive()) {
			pars += "&vars->" + ASTNode.STATE_FIELD;
		}
		if (mainDiagramType().containsInputVariablesTransitive()) {
			if (!pars.isEmpty()) pars += ", ";
			pars += "&vars->" + ASTNode.INPUT_FIELD;
		}
		if (mainDiagramType().containsOutputVariablesTransitive()) {
			if (!pars.isEmpty()) pars += ", ";
			pars += "&vars->" + ASTNode.OUTPUT_FIELD;
		}
		sb.append("  Main(" + pars + ");\n");
		sb.append("}\n");
	}

	public void ASTNode.genFunctionDefinitionsC(StringBuilder sb) {
		for (ASTNode child: astChildren()) {
			child.genFunctionDefinitionsC(sb);
		}
	}
	public void TypeDecl.genFunctionDefinitionsC(StringBuilder sb) {
	}
	public void DiagramType.genFunctionDefinitionsC(StringBuilder sb) {
		sb.append(functionSignature() + " {\n");
		
		// Step 1: compute values
		genBlocksC(sb);
		// Step 2: compute return value
		genReturnValueC(sb);
		// Step 3: update variables
		genUpdateVariablesC(sb);
		// Step 4: add return statement
		genReturnStatementC(sb);

		sb.append("}\n");
		
		// Generate code for anonymous subtypes
		for (Block b: getLocalBlocks()) {
			if (b.hasAnonymousDiagramType()) {
				b.anonymousDiagramType().genFunctionDefinitionsC(sb);
			}
		}
	}
	
	private void DiagramType.genBlocksC(StringBuilder sb) {
		// Sort blocks according to their data-flow order (DFO)
		ArrayList<Block> list = new ArrayList<Block>();
		for (Block b: getBlocks()) {
			list.add(b);
		}
		Collections.sort(list, new Comparator<Block>() {
			public int compare(Block b1, Block b2) {
				return b1.dfo() - b2.dfo();
			}
		});
		
		for(Block b: list) {
			sb.append("  ");
			if (!b.type().returnTypeC().equals("void")) {
				sb.append(b.type().returnTypeC() + " " + b.nameC() + " = ");
			}
			// Pass parameters
			sb.append(b.type().nameC() + "(");
			int i = 0;
			for (Port in: b.getInPortList()) {
				if (i++ > 0) sb.append(", ");
				sb.append(in.ingoingValueC());
			}
			// Pass state variable
			if (b.type().containsStateVariablesTransitive()) {
				if (i++ > 0) sb.append(", ");
				sb.append("&" + ASTNode.STATE_VAR + "->" + b.nameC());
			}
			// Pass input variable
			if (b.type().containsInputVariablesTransitive()) {
				if (i++ > 0) sb.append(", ");
				sb.append("&" + ASTNode.INPUT_VAR + "->" + b.nameC());
			}
			// Pass output variable
			if (b.type().containsOutputVariablesTransitive()) {
				if (i++ > 0) sb.append(", ");
				sb.append("&" + ASTNode.OUTPUT_VAR + "->" + b.nameC());
			}
			sb.append(");\n");
		}
	}
	
	private void DiagramType.genUpdateVariablesC(StringBuilder sb) {
		for (Variable v: variables()) {
			if (!v.ingoingValueC().isEmpty()) {
				sb.append("  " + v.nameC() + " = ");
				sb.append(v.ingoingValueC() + ";\n");
			}
		}
	}
	
	private void DiagramType.genReturnValueC(StringBuilder sb) {
		if (!returnTypeC().equals("void")) {
			sb.append("  " + returnTypeC() + " _result;\n");
			for (Parameter p: getOutParameters()) {
			    sb.append("  _result." + p.nameC() + " = " + p.ingoingValueC() + ";\n"); 
			}
		}
	}

	private void DiagramType.genReturnStatementC(StringBuilder sb) {
		if (!returnTypeC().equals("void")) {
			sb.append("  return _result;\n");
		}
	}

	public String Anchor.ingoingValueC() {
		if (!ingoingConnections().isEmpty()) {
			return ingoingConnections().iterator().next().cSourceName();
		} else {
			return ""; // may only happen for variables
		}
	}
	
	public String Connection.cSourceName() {
		return getSource().cCode();
	}

	public abstract String Expr.cCode();
	public String Literal.cCode() {
		return toString();
	}
	
	public String DotVarUse.cCode() {
		if (getVarUse().type().isExternalFunction()) {
			return getVarUse().cCode();
		} else {
			return getVarUse().cCode() + "." + getID();
		}
	}
	public String AbstractSimpleVarUse.cCode() {
		return decl().nameC();
	}
}

/**
 * Generate structs representing variables
 */
aspect VariableStructs {
	syn boolean TypeDecl.containsStateVariablesTransitive()
		= containsVariablesTransitive(StateVariable.class);
	syn boolean TypeDecl.containsInputVariablesTransitive()
		= containsVariablesTransitive(InputVariable.class);
	syn boolean TypeDecl.containsOutputVariablesTransitive()
		= containsVariablesTransitive(OutputVariable.class);
	syn boolean TypeDecl.containsVariablesTransitive()
		= containsVariablesTransitive(Variable.class);
	syn boolean TypeDecl.containsVariablesTransitive(Class<? extends Variable> clazz)
		= false;
	eq DiagramType.containsVariablesTransitive(Class<? extends Variable> clazz) {
		for (Variable v: variables()) {
			if (clazz.isInstance(v.declaredVariable())) {
				return true;
			}
		}
		for (Block b: blocks()) {
			if (b.type().containsVariablesTransitive(clazz)) {
				return true;
			}
		}
		return false;
	}

	syn String TypeDecl.stateStructName() = "<undefined>";
	eq DiagramType.stateStructName() = nameC() + "_STATE";
	syn String TypeDecl.inputStructName() = "<undefined>";
	eq DiagramType.inputStructName() = nameC() + "_INPUT";
	syn String TypeDecl.outputStructName() = "<undefined>";
	eq DiagramType.outputStructName() = nameC() + "_OUTPUT";

	public void Program.genVariableStructsC(StringBuilder sb) {
		// Create structs for all diagram types
		Map<TypeDecl, String> structs = new HashMap<>();
		for (DiagramType dt: allDiagramTypes()) {
			dt.genVariableStructsC(structs);
		}
		
		// Toplogical sort over types based on type reachability
		java.util.List<TypeDecl> list = Utils.topologicalSort(
			allDiagramTypes(),
			new SuccessorFunction<TypeDecl>() {
				public Collection<TypeDecl> successors(TypeDecl td) {
					return td.reachable();
				}
			},
			new Comparator<TypeDecl>() {
				public int compare(TypeDecl td1, TypeDecl td2) {
					return td1.nameC().compareTo(td2.nameC());
				}
			}
		);
		
		// Keep only types that have states (transitively)
		list.retainAll(structs.keySet());
		
		// Write structs in reverse toplogical order
		Collections.reverse(list);
		if (!list.isEmpty()) {
			for (TypeDecl td: list) {
				sb.append(structs.get(td));
			}
		}
	}
	
	public void DiagramType.genVariableStructsC(Map<TypeDecl, String> structs) {
		StringBuilder sb = new StringBuilder();

		// Generate struct for state variables
		if (containsStateVariablesTransitive() || name().equals("Main")) {
			sb.append("typedef struct {\n");
			for (Variable v: variables()) {
				if (v.isStateVariable()) {
					sb.append("  " + v.type().nameC() + " " + v.cNameDeclaration() + ";\n");
				}
			}
			for (Block b: blocks()) {
				if (b.type().containsStateVariablesTransitive()) {
					sb.append("  " + b.type().stateStructName() + " " + b.nameC() + ";\n");
				}
			}
			sb.append("} " + stateStructName() + ";\n");
		}

		// Generate struct for input variables
		if (containsInputVariablesTransitive() || name().equals("Main")) {
			sb.append("typedef struct {\n");
			for (Variable v: variables()) {
				if (v.isInputVariable()) {
					sb.append("  " + v.type().nameC() + " " + v.cNameDeclaration() + ";\n");
				}
			}
			for (Block b: blocks()) {
				if (b.type().containsInputVariablesTransitive()) {
					sb.append("  " + b.type().inputStructName() + " " + b.nameC() + ";\n");
				}
			}
			sb.append("} " + inputStructName() + ";\n");
		}

		// Generate struct for output variables
		if (containsOutputVariablesTransitive() || name().equals("Main")) {
			sb.append("typedef struct {\n");
			for (Variable v: variables()) {
				if (v.isOutputVariable()) {
					sb.append("  " + v.type().nameC() + " " + v.cNameDeclaration() + ";\n");
				}
			}
			for (Block b: blocks()) {
				if (b.type().containsOutputVariablesTransitive()) {
					sb.append("  " + b.type().outputStructName() + " " + b.nameC() + ";\n");
				}
			}
			sb.append("} " + outputStructName() + ";\n");
		}

		if (sb.length() > 0) {
			structs.put(this, sb.toString());
		}
	}

	public void Program.genMainWrapperStructC(StringBuilder sb) {
		sb.append("typedef struct {\n");
		sb.append("  " + mainDiagramType().stateStructName() + " " + ASTNode.STATE_FIELD + ";\n");
		sb.append("  " + mainDiagramType().inputStructName() + " " + ASTNode.INPUT_FIELD + ";\n");
		sb.append("  " + mainDiagramType().outputStructName() + " " + ASTNode.OUTPUT_FIELD + ";\n");
		sb.append("} Main_VARS;\n");
	}
}


aspect JSON {
	public void Program.genStateToJSON(StringBuilder sb) {
		sb.append("char *bloqqi_to_json(Main_VARS *vars) {\n");
		sb.append("  const int MAX_BUF = 4096;\n");
		sb.append("  char *c = malloc(MAX_BUF);\n");
		sb.append("  int len = 0;\n");
		sb.append("  len += snprintf(c+len, MAX_BUF-len, \"{\");\n");

		mainDiagramType().genStateToJSON(sb, "");

		sb.append("  if (len > 2) {\n");
		sb.append("    len -= 2; /* Remove last comma */\n");
		sb.append("  }\n");
		sb.append("  len += snprintf(c+len, MAX_BUF-len, \"}\");\n");
		sb.append("  return c;\n");
		sb.append("}\n");
	}
	public void TypeDecl.genStateToJSON(StringBuilder sb, String enclosingPath) {
	}
	public void DiagramType.genStateToJSON(StringBuilder sb, String enclosingPath) {
		for (Variable v: variables()) {
			String vPath = enclosingPath + v.cNameDeclaration();
			String fmtType = "%d";
			if (v.type().isReal()) fmtType = "%f";
			else if (v.type().isString()) fmtType = "%s";
			String fmt = "\"\\\"" + vPath + "\\\": "
				+ "{\\\"value\\\": " + fmtType + ", "
				+ "\\\"type\\\": \\\"" + v.fieldNameInMainStructC() +"\\\"}, \"";
			sb.append("  len += snprintf(c+len, MAX_BUF-len, " + fmt
				+ ", vars->" + v.fieldNameInMainStructC() + "." + vPath + ");\n");
		}
		for (Block b: blocks()) {
			if (b.type().containsVariablesTransitive()) {
				String enc = enclosingPath + b.nameC() + ".";
				b.type().genStateToJSON(sb, enc);
			}
		}
	}


	public void Program.genSetInputVariable(StringBuilder sb) {
		sb.append("void bloqqi_set_input_variable(Main_VARS *vars, const char *path, const char *value) {\n");
		mainDiagramType().genSetInputVariable(sb, "");
		sb.append("}\n");
	}
	public void TypeDecl.genSetInputVariable(StringBuilder sb, String enclosingPath) {
	}
	public void DiagramType.genSetInputVariable(StringBuilder sb, String enclosingPath) {
		for (Variable v: variables()) {
			if (v.isInputVariable()) {
				String convertFunc = "";
				if (v.type().isInteger()) convertFunc = "atoi";
				if (v.type().isBool()) convertFunc = "atoi";
				if (v.type().isReal()) convertFunc = "atof";

				String vPath = enclosingPath + v.cNameDeclaration();
				String access = "vars->" + v.fieldNameInMainStructC() + "." + vPath;
				sb.append("  if (strcmp(path, \"" + vPath + "\") == 0) {\n");
				sb.append("    " + access + " = " + convertFunc + "(value);\n");
				sb.append("  }\n");
			}
		}
		for (Block b: blocks()) {
			if (b.type().containsInputVariablesTransitive()) {
				String enc = enclosingPath + b.nameC() + ".";
				b.type().genSetInputVariable(sb, enc);
			}
		}
	}

}

/**
 * Names in C.
 */
aspect CNames {
	syn String Variable.prefixCVarName() {
		String prefix = "";
		if (isStateVariable()) prefix = ASTNode.STATE_VAR;
		if (isInputVariable()) prefix = ASTNode.INPUT_VAR;
		if (isOutputVariable()) prefix = ASTNode.OUTPUT_VAR;
		return prefix;
	}
	syn String Variable.fieldNameInMainStructC() {
		String field = "";
		if (isStateVariable()) field = ASTNode.STATE_FIELD;
		if (isInputVariable()) field = ASTNode.INPUT_FIELD;
		if (isOutputVariable()) field = ASTNode.OUTPUT_FIELD;
		return field;
	}
	syn String VarDecl.nameC() = nameCFiltered();
	eq Variable.nameC() = prefixCVarName() + "->" + cNameDeclaration();
	eq WiringInParameter.nameC() = "<undefined>";
	eq WiringOutParameter.nameC() = "<undefined>";
	eq RecommendationGroup.nameC() = "<undefined>";
	syn String Variable.cNameDeclaration() = ASTNode.filterCName(name());
	
	syn String TypeDecl.nameC() = ASTNode.filterCName(name());
	
	coll Set<String> Program.declaredCNames() [new HashSet<String>()] with add;
	TypeDecl contributes nameC()
		to Program.declaredCNames() for program();
	syn boolean Program.isCNameDeclared(String name)
		= declaredCNames().contains(name);
	
	syn String VarDecl.nameCFiltered() {
		String name = ASTNode.filterCName(name());
		if (program().isCNameDeclared(name)) {
			name = "_" + name;
		}
		return name;
	}

	public static String ASTNode.filterCName(String name) {
		name = name.replace("$", "__");
		if (getReservedCNames().contains(name)) {
			name = "_" + name;
		}
		return name;
	}
	private static Set<String> ASTNode.reservedCNames;
	public static Set<String> ASTNode.getReservedCNames() {
		if (reservedCNames == null) {
			initReservedCNames();
		}
		return reservedCNames;
	}
	public static void ASTNode.initReservedCNames() {
		reservedCNames = new HashSet<String>();
		
		// Keywords
		reservedCNames.add("auto");
		reservedCNames.add("_Bool");
		reservedCNames.add("break");
		reservedCNames.add("case");
		reservedCNames.add("char");
		reservedCNames.add("_Complex");
		reservedCNames.add("const");
		reservedCNames.add("continue");
		reservedCNames.add("default");
		reservedCNames.add("do");
		reservedCNames.add("double");
		reservedCNames.add("else");
		reservedCNames.add("enum");
		reservedCNames.add("extern");
		reservedCNames.add("float");
		reservedCNames.add("for");
		reservedCNames.add("goto");
		reservedCNames.add("if");
		reservedCNames.add("_Imaginary");
		reservedCNames.add("inline");
		reservedCNames.add("int");
		reservedCNames.add("long");
		reservedCNames.add("register");
		reservedCNames.add("restrict");
		reservedCNames.add("return");
		reservedCNames.add("short");
		reservedCNames.add("signed");
		reservedCNames.add("sizeof");
		reservedCNames.add("static");
		reservedCNames.add("struct");
		reservedCNames.add("switch");
		reservedCNames.add("typedef");
		reservedCNames.add("union");
		reservedCNames.add("unsigned");
		reservedCNames.add("void");
		reservedCNames.add("volatile");
		reservedCNames.add("while");
		
		// Other
		reservedCNames.add("bool");
		reservedCNames.add("printf");
		// Add more, for example, names in stdio.h, stdlib.h.
		// Or possible always prefix names with an underscore.
	}
}
