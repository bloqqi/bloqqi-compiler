diagramtype PFFPar(Int Gain, Int SP, Int PV, Bool EnableFF, Int FFGain, Int FF => Int Out) {
  Sub_1;
  Mul_1;
  Mul_2;
  Add_1;
  If_1;
  connect(SP, Sub_1.in1);
  connect(PV, Sub_1.in2);
  connect(Gain, Mul_1.in1);
  connect(Sub_1, Mul_1.in2);
  connect(Mul_1, Add_1.in1);
  connect(Add_1, Out);
  connect(FFGain, Mul_2.in1);
  connect(FF, Mul_2.in2);
  connect(EnableFF, If_1.en);
  connect(Mul_2, If_1.in);
  connect(If_1, Add_1.in2);
}
