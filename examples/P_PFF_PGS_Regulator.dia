diagramtype P(Int Gain, Int SP, Int PV => Int Out) {
  Sub_1;
  Mul_1;
  connect(SP, Sub_1.in1);
  connect(PV, Sub_1.in2);
  connect(Gain, Mul_1.in1);
  connect(Sub_1, Mul_1.in2);
  connect(Mul_1, Out);
}
annotation(
  Out = (329, 6, 50, 25),
  Sub_1 = (79, 35, 40, 30),
  PV = (7, 56, 50, 25),
  Gain = (7, 6, 50, 25),
  Mul_1 = (147, 10, 40, 30),
  SP = (7, 31, 50, 25)
)
diagramtype PFF(Int FFGain, Int FF) extends P {
  Mul_2;
  Add_1;
  connect(FFGain, Mul_2.in1);
  connect(FF, Mul_2.in2);
  connect(Mul_2, Add_1.in2);
  intercept Out with Add_1.in1, Add_1;
}
