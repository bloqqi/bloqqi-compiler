  P:SP = (7, 31, 50, 25)
)
diagramtype PGS(Int GS, Int Gain2, Int Gain3) extends P {
  Mux3_1;
  connect(GS, Mux3_1.k);
  connect(Gain2, Mux3_1.in2);
  connect(Gain3, Mux3_1.in3);
  intercept Mul_1.in1 with Mux3_1.in1, Mux3_1;
}
