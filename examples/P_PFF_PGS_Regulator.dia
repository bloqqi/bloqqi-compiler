  connect(FF, Mul_2.in2);
  connect(EnableFF, If_1.en);
  connect(Mul_2, If_1.in);
  connect(If_1, Add_1.in2);
  connect(Gain, Mux3_1.in1);
  connect(GS, Mux3_1.k);
  connect(Gain3, Mux3_1.in2);
  connect(Gain2, Mux3_1.in3);
  connect(Mux3_1, Mul_1.in1);
}
