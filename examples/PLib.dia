)
diagramtype IPart(e: Real, K: Real, Ti: Real, Track: Bool, TrackValue: Real, PDPart: Real => IPart: Real) {
  var iPart: Real;
  input h: Real;
  RAdd_1;
  SelReal_1;
  RSub_1;
  RMul_1;
  RMul_2;
  RDiv_1;
  connect(iPart, RAdd_1.in2);
  connect(RAdd_1.out, SelReal_1.in1);
  connect(Track, SelReal_1.sel);
  connect(SelReal_1.out, IPart);
  connect(SelReal_1.out, iPart);
  connect(TrackValue, RSub_1.in1);
  connect(PDPart, RSub_1.in2);
  connect(RSub_1.out, SelReal_1.in2);
  connect(e, RMul_1.in1);
  connect(RMul_1.out, RAdd_1.in1);
  connect(K, RMul_2.in1);
  connect(h, RMul_2.in2);
  connect(RMul_2.out, RDiv_1.in1);
  connect(Ti, RDiv_1.in2);
  connect(RDiv_1.out, RMul_1.in2);
}
