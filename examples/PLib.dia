  Td = (4, 80, 42, 20)
)
diagramtype PTrack(Track: Bool, TrackValue: Real) extends P {
  SelReal_1;
  connect(Track, SelReal_1.sel);
  intercept Out with SelReal_1.in2, SelReal_1.out;
  connect(TrackValue, SelReal_1.in1);
}
