  Track = (213, 3, 68, 20),
  TrackValue = (213, 22, 68, 20)
)
features P {
  Derivative: PD;
  Integral: PI;
  PTrack: PTrack;
  PTrack excludes Integral;
  Derivative before Integral;
  Derivative before PTrack;
}
diagramtype Main {
  pid: P {
    feature Derivative;
    feature Integral;
  };
}
