diagramtype P(SP: Real, PV: Real, K: Real => Out: Real) {
  e: RSub;
  PPart: RMul;
  connect(e.out, PPart.in1);
  connect(K, PPart.in2);
  connect(SP, e.in1);
  connect(PV, e.in2);
  connect(PPart.out, Out);
}
