diagramtype DPart(K: Real, PV: Real, Td: Real, N: Real => DPart: Real) {
  var currentD: Real;
  var prevPV: Real;
  input h: Real;
  RMul_1;
  RAdd_1;
  RDiv_1;
  RMul_2;
  RSub_1;
  RMul_3;
  RMul_4;
  RDiv_2;
  RSub_2;
  RMul_5;
  connect(PV, prevPV);
  connect(N, RMul_1.in1);
  connect(h, RMul_1.in2);
  connect(Td, RAdd_1.in1);
  connect(RMul_1.out, RAdd_1.in2);
  connect(Td, RDiv_1.in1);
  connect(RAdd_1.out, RDiv_1.in2);
  connect(RDiv_1.out, RMul_2.in2);
  connect(currentD, RMul_2.in1);
  connect(RMul_2.out, RSub_1.in1);
  connect(Td, RMul_3.in1);
  connect(K, RMul_3.in2);
  connect(N, RMul_4.in2);
  connect(RMul_3.out, RMul_4.in1);
  connect(RMul_4.out, RDiv_2.in1);
  connect(RAdd_1.out, RDiv_2.in2);
  connect(PV, RSub_2.in1);
  connect(prevPV, RSub_2.in2);
  connect(RSub_1.out, DPart);
  connect(RSub_1.out, currentD);
  connect(RDiv_2.out, RMul_5.in1);
  connect(RSub_2.out, RMul_5.in2);
  connect(RMul_5.out, RSub_1.in2);
}
