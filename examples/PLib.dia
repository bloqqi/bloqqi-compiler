)
diagramtype PD(Td: Real, N: Real) extends P {
  DPart: DPart;
  RAdd_1;
  connect(Td, DPart.Td);
  connect(PV, DPart.PV);
  connect(DPart.DPart, RAdd_1.in2);
  intercept Out with RAdd_1.in1, RAdd_1.out;
  connect(N, DPart.N);
  connect(K, DPart.K);
}
