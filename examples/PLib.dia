diagramtype Rid(in: Real => out: Real) {
  connect(in, out);
}
annotation(
  out = (129, 10, 60, 20)
)
diagramtype PI(Track: Bool, TrackValue: Real, Ti: Real) extends P {
  IPart: IPart;
  Rid: Rid;
  RAdd_1;
  connect(e.out, IPart.e);
  connect(Ti, IPart.Ti);
  connect(Track, IPart.Track);
  connect(TrackValue, IPart.TrackValue);
  connect(IPart.IPart, RAdd_1.in1);
  intercept Out with Rid.in, RAdd_1.out;
  connect(Rid.out, IPart.PDPart);
  connect(Rid.out, RAdd_1.in2);
  connect(K, IPart.K);
}
